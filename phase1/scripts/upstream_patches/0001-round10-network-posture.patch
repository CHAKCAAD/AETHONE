diff -ruN a/auto_relay.go patched/auto_relay.go
--- a/auto_relay.go	1970-01-01 00:00:00.000000000 +0000
+++ b/auto_relay.go	2026-11-16 08:30:05.072318622 +0000
@@ -0,0 +1,398 @@
+package vpnclient
+
+// The automatic shared Guardian relay pool — the reference project's own
+// answer to Mozilla refusing a region (arman-vpn-client,
+// internal/service/auto_relay.go): after a Guardian request has already
+// answered HTTP 451, and the doubled-path direct retry (guardian.go) has
+// not got past the edge either, the pool fetches the SHARED relay list
+// from the reference's public update manifest (plus its jsDelivr mirror),
+// health-checks candidates, and forwards the request through a healthy
+// relay: an https:// URL that takes the target in its `url` parameter
+// (docs/relay: a Cloudflare Worker or a PHP file) and answers with the
+// target's response.
+//
+// The pool is lazy — no manifest request, health probe or account request
+// is sent until a production Guardian request has ALREADY returned 451 —
+// and the candidates' state lives in memory only. The reference's ECH
+// layer (network.api_relay_ech) is out of scope here and stays a future
+// seam; the relays in the manifest are Cloudflare Workers whose names
+// answer without it.
+
+import (
+        "context"
+        "crypto/tls"
+        "encoding/json"
+        "errors"
+        "fmt"
+        "io"
+        "math/rand/v2"
+        "net"
+        "net/http"
+        "net/url"
+        "strings"
+        "sync"
+        "time"
+)
+
+const (
+        relayManifestURL    = "https://raw.githubusercontent.com/arman-org/update-manifests/main/arman-vpn-client/updates.json"
+        relayManifestMirror = "https://cdn.jsdelivr.net/gh/arman-org/update-manifests@main/arman-vpn-client/updates.json"
+        autoRelayBudget     = 20 * time.Second
+        relayProbeTimeout   = 4 * time.Second
+        relayHandshakeWait  = 8 * time.Second
+        maxRelayManifest    = 512 * 1024
+
+        // relayFirstFor is how long, after a request had to go through a
+        // relay, the next ones go there first.
+        relayFirstFor = 10 * time.Minute
+        // relayBadFor is how long an unhealthy or refused relay is skipped.
+        relayBadFor = time.Minute
+)
+
+// automaticRelays is the shared pool. Lazy by construction: load() runs
+// only from recover(), which runs only after a 451.
+var automaticRelays = newRelayPool()
+
+func newRelayPool() *relayPool {
+        p := &relayPool{
+                badUntil: make(map[string]time.Time),
+                shuffle:  rand.Shuffle,
+        }
+        p.transport = p.relayTransport
+        return p
+}
+
+type relayPool struct {
+        mu          sync.Mutex
+        manifests   []string
+        client      *http.Client
+        transport   func(*url.URL) (http.RoundTripper, error)
+        shuffle     func(int, func(int, int))
+        urls        []string
+        refreshAt   time.Time
+        active      string
+        activeUntil time.Time
+        badUntil    map[string]time.Time
+}
+
+// relayManifests is its own function so tests can pin the pool's sources.
+func (p *relayPool) manifestSources() []string {
+        if p.manifests != nil {
+                return p.manifests
+        }
+        return []string{relayManifestURL, relayManifestMirror}
+}
+
+// relayHTTPClient builds the manifest/health client: direct dials on the
+// process resolver (dnsresolver.Install has installed the racing policy),
+// plain TLS, short timeouts.
+func (p *relayPool) manifestClient() *http.Client {
+        if p.client != nil {
+                return p.client
+        }
+        p.client = &http.Client{
+                Transport: &http.Transport{
+                        Proxy:           nil,
+                        TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12},
+                        DialContext: (&net.Dialer{Timeout: relayProbeTimeout}).DialContext,
+                },
+                Timeout: relayProbeTimeout,
+                CheckRedirect: func(*http.Request, []*http.Request) error {
+                        return http.ErrUseLastResponse
+                },
+        }
+        return p.client
+}
+
+// load accepts a valid empty/disabled primary as authoritative; the
+// mirror is tried only for an invalid or unreachable file. Input size
+// and candidate count are bounded. No URL with a relay secret is logged.
+func (p *relayPool) load(ctx context.Context) {
+        if time.Now().Before(p.refreshAt) {
+                return
+        }
+        p.refreshAt = time.Now().Add(time.Minute)
+        for _, source := range p.manifestSources() {
+                req, err := http.NewRequestWithContext(ctx, http.MethodGet, source, nil)
+                if err != nil {
+                        continue
+                }
+                req.Header.Set("Accept", "application/json")
+                resp, err := p.manifestClient().Do(req)
+                if err != nil {
+                        continue
+                }
+                body, readErr := io.ReadAll(io.LimitReader(resp.Body, maxRelayManifest+1))
+                resp.Body.Close()
+                if readErr != nil || resp.StatusCode != http.StatusOK || len(body) > maxRelayManifest {
+                        continue
+                }
+                var manifest struct {
+                        Relays *struct {
+                                Enabled bool     `json:"enabled"`
+                                URLs    []string `json:"urls"`
+                        } `json:"relays"`
+                }
+                if json.Unmarshal(body, &manifest) != nil {
+                        continue
+                }
+                var candidates []string
+                seen := map[string]bool{}
+                if manifest.Relays != nil && manifest.Relays.Enabled {
+                        for _, raw := range manifest.Relays.URLs {
+                                u, err := url.Parse(strings.TrimSpace(raw))
+                                if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.User != nil || u.Fragment != "" {
+                                        continue
+                                }
+                                q := u.Query()
+                                if q.Has("url") || q.Has("health") {
+                                        continue
+                                }
+                                raw = u.String()
+                                if !seen[raw] {
+                                        candidates = append(candidates, raw)
+                                        seen[raw] = true
+                                }
+                                if len(candidates) >= 100 {
+                                        break
+                                }
+                        }
+                }
+                p.urls = candidates
+                for raw := range p.badUntil {
+                        if !seen[raw] {
+                                delete(p.badUntil, raw)
+                        }
+                }
+                p.refreshAt = time.Now().Add(10 * time.Minute)
+                if !seen[p.active] {
+                        p.active = ""
+                        p.activeUntil = time.Time{}
+                }
+                return
+        }
+        // A failed refresh invents nothing and erases nothing; the next 451
+        // retries it after a minute.
+}
+
+// healthy probes one relay: ?health=1 must answer the reference's own
+// report shape.
+func (p *relayPool) healthy(ctx context.Context, relay *url.URL) bool {
+        u := *relay
+        query := u.Query()
+        query.Set("health", "1")
+        u.RawQuery = query.Encode()
+        req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+        if err != nil {
+                return false
+        }
+        req.Header.Set("Accept", "application/json")
+        req.Header.Set("Cache-Control", "no-cache")
+        transport, terr := p.transport(relay)
+        if terr != nil {
+                return false
+        }
+        client := &http.Client{
+                Transport: transport,
+                Timeout:   2 * relayProbeTimeout,
+                CheckRedirect: func(*http.Request, []*http.Request) error {
+                        return http.ErrUseLastResponse
+                },
+        }
+        resp, err := client.Do(req)
+        if err != nil {
+                return false
+        }
+        defer resp.Body.Close()
+        var report struct {
+                Relay   string `json:"relay"`
+                Version int    `json:"version"`
+                Ready   bool   `json:"ready"`
+        }
+        return resp.StatusCode == http.StatusOK &&
+                json.NewDecoder(io.LimitReader(resp.Body, 4096)).Decode(&report) == nil &&
+                report.Relay == "arman-vpn" && report.Version == 1 && report.Ready
+}
+
+// relayTransport dials the relay itself DIRECT (the process resolver's
+// racing policy + the hello split — the relay is reached the way every
+// other direct connection is).
+func (p *relayPool) relayTransport(relay *url.URL) (http.RoundTripper, error) {
+        return &http.Transport{
+                Proxy:                 nil,
+                TLSClientConfig:       &tls.Config{MinVersion: tls.VersionTLS12},
+                TLSHandshakeTimeout:   relayHandshakeWait,
+                ResponseHeaderTimeout: 2 * relayProbeTimeout,
+                DialContext: (&net.Dialer{
+                        Timeout:   relayProbeTimeout,
+                        KeepAlive: 30 * time.Second,
+                }).DialContext,
+                DialTLSContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+                        raw, err := (&net.Dialer{Timeout: relayProbeTimeout}).DialContext(ctx, network, addr)
+                        if err != nil {
+                                return nil, err
+                        }
+                        host, _, splitErr := net.SplitHostPort(addr)
+                        if splitErr != nil {
+                                _ = raw.Close()
+                                return nil, splitErr
+                        }
+                        tlsConn := tls.Client(raw, &tls.Config{
+                                ServerName: host,
+                                MinVersion: tls.VersionTLS12,
+                        })
+                        shakeCtx, cancel := context.WithTimeout(ctx, relayHandshakeWait)
+                        defer cancel()
+                        if err := tlsConn.HandshakeContext(shakeCtx); err != nil {
+                                _ = raw.Close()
+                                return nil, err
+                        }
+                        return tlsConn, nil
+                },
+        }, nil
+}
+
+// recover forwards req through the first healthy relay. It returns
+// (nil, nil) when no relay could be used — the caller then keeps the
+// original 451 response.
+func (p *relayPool) recover(req *http.Request) (*http.Response, error) {
+        // The pool is Guardian-only (the reference's gate): the shared relays
+        // forward the account-server paths, never anything else.
+        if !isGuardianRequest(req) || (req.Body != nil && req.GetBody == nil) {
+                return nil, nil
+        }
+        ctx, cancel := context.WithTimeout(req.Context(), autoRelayBudget)
+        handedOff := false
+        defer func() {
+                if !handedOff {
+                        cancel()
+                }
+        }()
+        p.mu.Lock()
+        defer p.mu.Unlock()
+        if ctx.Err() != nil {
+                return nil, ctx.Err()
+        }
+        p.load(ctx)
+        order := append([]string(nil), p.urls...)
+        p.shuffle(len(order), func(i, j int) { order[i], order[j] = order[j], order[i] })
+        if p.active != "" && time.Now().Before(p.activeUntil) {
+                order = append([]string{p.active}, order...)
+        }
+        seen := map[string]bool{}
+        for _, raw := range order {
+                if ctx.Err() != nil {
+                        break
+                }
+                if seen[raw] || time.Now().Before(p.badUntil[raw]) {
+                        continue
+                }
+                seen[raw] = true
+                u, err := url.Parse(raw)
+                if err != nil {
+                        continue
+                }
+                transport, terr := p.transport(u)
+                if terr != nil {
+                        continue
+                }
+                if !p.healthy(ctx, u) {
+                        p.badUntil[raw] = time.Now().Add(relayBadFor)
+                        continue
+                }
+                out := req.Clone(ctx)
+                if req.Body != nil {
+                        out.Body, err = req.GetBody()
+                        if err != nil {
+                                return nil, err
+                        }
+                }
+                resp, err := forwardThroughRelay(transport, u, out)
+                if err == nil && usableGuardianRelayResponse(req, resp) {
+                        // The body still uses ctx; keep its deadline alive until the
+                        // caller closes it rather than cancelling on this return.
+                        resp.Body = &relayBody{ReadCloser: resp.Body, cancel: cancel}
+                        handedOff = true
+                        p.active, p.activeUntil = raw, time.Now().Add(relayFirstFor)
+                        resp.Request = req
+                        return resp, nil
+                }
+                if resp != nil {
+                        resp.Body.Close()
+                }
+                p.badUntil[raw] = time.Now().Add(relayBadFor)
+                if req.Method != http.MethodGet && req.Method != http.MethodHead &&
+                        (err != nil || resp == nil || resp.StatusCode != http.StatusUnavailableForLegalReasons) {
+                        break
+                }
+        }
+        return nil, errors.New("no healthy Guardian relay is available")
+}
+
+// forwardThroughRelay sends req to the relay with the target URL in the
+// relay's url parameter, the method, headers and body as they are; the
+// relay forwards it and answers with the target's response. The response
+// keeps the original request, so cookies and redirects resolve against
+// the target. A relay that refuses (X-Relay-Error) is an error naming the
+// relay.
+func forwardThroughRelay(base http.RoundTripper, relay *url.URL, req *http.Request) (*http.Response, error) {
+        target := *relay
+        query := target.Query()
+        query.Set("url", req.URL.String())
+        target.RawQuery = query.Encode()
+        out := req.Clone(req.Context())
+        out.URL = &target
+        out.Host = ""
+        resp, err := base.RoundTrip(out)
+        if err != nil {
+                return nil, fmt.Errorf("API relay %s: %w", relay.Host, err)
+        }
+        if reason := resp.Header.Get("X-Relay-Error"); reason != "" {
+                resp.Body.Close()
+                return nil, fmt.Errorf("API relay %s refused %s: %s", relay.Host, req.URL.Host, reason)
+        }
+        resp.Request = req
+        return resp, nil
+}
+
+// isGuardianRequest gates the pool: only the Guardian endpoint's
+// /api/v1/fpn/ paths (the reference's exact rule; the engine's Guardian
+// endpoint defaults to the same vpn.mozilla.org).
+func isGuardianRequest(req *http.Request) bool {
+        if req.URL == nil {
+                return false
+        }
+        host := req.URL.Host
+        if host == "" {
+                host = req.Host
+        }
+        return strings.TrimSuffix(strings.ToLower(host), "/") == guardianEndpointHost &&
+                strings.HasPrefix(req.URL.Path, "/api/v1/fpn/")
+}
+
+// usableGuardianRelayResponse accepts only responses a real Guardian
+// relay-forward produced (the reference's shape: X-Arman-Relay: 1 and a
+// JSON body on the statuses Guardian itself answers).
+func usableGuardianRelayResponse(req *http.Request, resp *http.Response) bool {
+        if resp == nil || resp.Header.Get("X-Arman-Relay") != "1" {
+                return false
+        }
+        switch resp.StatusCode {
+        case http.StatusOK, http.StatusUnauthorized, http.StatusForbidden, http.StatusTooManyRequests:
+                return strings.Contains(strings.ToLower(resp.Header.Get("Content-Type")), "application/json")
+        }
+        return false
+}
+
+// relayBody keeps the recovery context alive until the caller closes the
+// response body.
+type relayBody struct {
+        io.ReadCloser
+        cancel context.CancelFunc
+}
+
+func (b *relayBody) Close() error {
+        err := b.ReadCloser.Close()
+        b.cancel()
+        return err
+}
diff -ruN a/auto_relay_test.go patched/auto_relay_test.go
--- a/auto_relay_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/auto_relay_test.go	2026-11-16 08:30:05.073318628 +0000
@@ -0,0 +1,228 @@
+package vpnclient
+
+import (
+        "context"
+        "crypto/tls"
+        "encoding/base64"
+        "encoding/json"
+        "net/http"
+        "net/http/httptest"
+        "net/url"
+        "strings"
+        "sync"
+        "testing"
+        "time"
+)
+
+// TestGuardian451DoubledPathRecovery (the reference's region_recovery
+// tests, adapted): a Guardian request the edge answers 451 is retried
+// with a doubled leading slash; when THAT passes, the recovered response
+// is what the caller sees.
+func TestGuardian451DoubledPathRecovery(t *testing.T) {
+        var paths []string
+        var mu sync.Mutex
+        transport := identityTestTransport(func(req *http.Request) (*http.Response, error) {
+                mu.Lock()
+                paths = append(paths, req.URL.Path)
+                mu.Unlock()
+                if req.URL.Path == "/api/v1/fpn/token" {
+                        return identityTestResponse(req, http.StatusUnavailableForLegalReasons, `{"errno":998}`), nil
+                }
+                if req.URL.Path == "//api/v1/fpn/token" {
+                        return identityTestResponse(req, http.StatusOK, `{"token":"`+testProxyPassJWT(t)+`"}`), nil
+                }
+                return identityTestResponse(req, http.StatusTeapot, `{}`), nil
+        })
+        useIdentityTestClient(t, transport, "")
+
+        pass, err := fetchProxyPass(context.Background(), GuardianEndpointDefault, "fixture-token")
+        if err != nil {
+                t.Fatal(err)
+        }
+        if pass.RawToken == "" {
+                t.Fatal("the doubled-path recovery must produce the pass")
+        }
+        if len(paths) != 2 || paths[0] != "/api/v1/fpn/token" || paths[1] != "//api/v1/fpn/token" {
+                t.Fatalf("the walk must be literal then doubled, got %v", paths)
+        }
+}
+
+// TestGuardian451RelayPoolRecovery: when the doubled path is still 451,
+// the automatic shared relay pool carries the request — the manifest is
+// fetched, the candidate health-checked, and the target forwarded through
+// the relay's url parameter with X-Arman-Relay validation.
+func TestGuardian451RelayPoolRecovery(t *testing.T) {
+        var guardianMu sync.Mutex
+        guardianPaths := []string{}
+
+        // The relay: health endpoint + the forwarded Guardian call. TLS
+        // (the pool accepts only https relays, like the reference); the
+        // pinned test transport trusts the self-signed cert.
+        relay := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+                if r.URL.Query().Get("health") == "1" {
+                        w.Header().Set("Content-Type", "application/json")
+                        _, _ = w.Write([]byte(`{"relay":"arman-vpn","version":1,"ready":true}`))
+                        return
+                }
+                target := r.URL.Query().Get("url")
+                if target == "" {
+                        w.WriteHeader(http.StatusBadRequest)
+                        return
+                }
+                u, err := url.Parse(target)
+                if err != nil || u.Host != "vpn.mozilla.org" || !strings.HasPrefix(u.Path, "/api/v1/fpn/") {
+                        w.Header().Set("X-Relay-Error", "only Guardian fpn paths")
+                        w.WriteHeader(http.StatusForbidden)
+                        return
+                }
+                guardianMu.Lock()
+                guardianPaths = append(guardianPaths, u.Path)
+                guardianMu.Unlock()
+                w.Header().Set("Content-Type", "application/json")
+                w.Header().Set("X-Arman-Relay", "1")
+                _, _ = w.Write([]byte(`{"token":"` + testProxyPassJWT(t) + `"}`))
+        }))
+        defer relay.Close()
+
+        // The manifest the pool loads (pinned to the test server).
+        manifest := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+                w.Header().Set("Content-Type", "application/json")
+                _ = json.NewEncoder(w).Encode(map[string]any{
+                        "relays": map[string]any{
+                                "enabled": true,
+                                "urls":    []string{relay.URL},
+                        },
+                })
+        }))
+        defer manifest.Close()
+
+        reset := pinRelayPoolForTest(t, []string{manifest.URL})
+
+        // The control plane: 451 on both the literal and the doubled path.
+        transport := identityTestTransport(func(req *http.Request) (*http.Response, error) {
+                return identityTestResponse(req, http.StatusUnavailableForLegalReasons, `{"errno":998}`), nil
+        })
+        useIdentityTestClient(t, transport, "")
+
+        pass, err := fetchProxyPass(context.Background(), GuardianEndpointDefault, "fixture-token")
+        if err != nil {
+                t.Fatal(err)
+        }
+        if pass.RawToken == "" {
+                t.Fatal("the relay recovery must produce the pass")
+        }
+        guardianMu.Lock()
+        defer guardianMu.Unlock()
+        if len(guardianPaths) != 1 || guardianPaths[0] != "/api/v1/fpn/token" {
+                t.Fatalf("the relay must have forwarded the token path once, got %v", guardianPaths)
+        }
+        reset()
+}
+
+// TestGuardianRelayGate: the pool never carries a non-Guardian path and
+// never a host other than the Guardian endpoint (the reference's exact
+// rule).
+func TestGuardianRelayGate(t *testing.T) {
+        req, _ := http.NewRequest(http.MethodGet, "https://api.accounts.firefox.com/v1/account/login", nil)
+        if isGuardianRequest(req) {
+                t.Fatal("an FxA request must not pass the gate")
+        }
+        req, _ = http.NewRequest(http.MethodGet, "https://vpn.mozilla.org/api/v2/other", nil)
+        if isGuardianRequest(req) {
+                t.Fatal("a non-fpn Guardian path must not pass the gate")
+        }
+        req, _ = http.NewRequest(http.MethodGet, "https://vpn.mozilla.org/api/v1/fpn/token", nil)
+        if !isGuardianRequest(req) {
+                t.Fatal("the fpn token path must pass the gate")
+        }
+        req, _ = http.NewRequest(http.MethodGet, "https://evil.example/api/v1/fpn/token", nil)
+        if isGuardianRequest(req) {
+                t.Fatal("a foreign host must not pass the gate")
+        }
+}
+
+// TestUsableGuardianRelayResponse: only X-Arman-Relay answers with the
+// statuses Guardian itself answers and a JSON body are usable.
+func TestUsableGuardianRelayResponse(t *testing.T) {
+        req, _ := http.NewRequest(http.MethodGet, "https://vpn.mozilla.org/api/v1/fpn/token", nil)
+        good := &http.Response{StatusCode: http.StatusOK, Header: http.Header{}}
+        good.Header.Set("X-Arman-Relay", "1")
+        good.Header.Set("Content-Type", "application/json")
+        if !usableGuardianRelayResponse(req, good) {
+                t.Fatal("a valid relay answer must be usable")
+        }
+        noMark := &http.Response{StatusCode: http.StatusOK, Header: http.Header{}}
+        noMark.Header.Set("Content-Type", "application/json")
+        if usableGuardianRelayResponse(req, noMark) {
+                t.Fatal("an answer without X-Arman-Relay must be refused")
+        }
+        html := &http.Response{StatusCode: http.StatusOK, Header: http.Header{}}
+        html.Header.Set("X-Arman-Relay", "1")
+        html.Header.Set("Content-Type", "text/html")
+        if usableGuardianRelayResponse(req, html) {
+                t.Fatal("a non-JSON answer must be refused")
+        }
+        teapot := &http.Response{StatusCode: http.StatusTeapot, Header: http.Header{}}
+        teapot.Header.Set("X-Arman-Relay", "1")
+        teapot.Header.Set("Content-Type", "application/json")
+        if usableGuardianRelayResponse(req, teapot) {
+                t.Fatal("a status Guardian never answers must be refused")
+        }
+}
+
+// pinRelayPoolForTest pins the pool's manifest sources and relay
+// transport and resets its state; the returned func restores everything.
+func pinRelayPoolForTest(t *testing.T, sources []string) func() {
+        t.Helper()
+        previousManifests := automaticRelays.manifests
+        previousClient := automaticRelays.client
+        previousTransport := automaticRelays.transport
+        previousURLs := automaticRelays.urls
+        previousRefresh := automaticRelays.refreshAt
+        previousActive := automaticRelays.active
+        previousActiveUntil := automaticRelays.activeUntil
+        previousBad := automaticRelays.badUntil
+        automaticRelays.manifests = sources
+        automaticRelays.client = nil
+        // The transport the pool uses for the relays: the test relay's
+        // self-signed certificate is trusted HERE ONLY.
+        automaticRelays.transport = func(*url.URL) (http.RoundTripper, error) {
+                return &http.Transport{
+                        Proxy:           nil,
+                        TLSClientConfig: &tls.Config{InsecureSkipVerify: true, MinVersion: tls.VersionTLS12},
+                }, nil
+        }
+        automaticRelays.urls = nil
+        automaticRelays.refreshAt = time.Time{}
+        automaticRelays.active = ""
+        automaticRelays.activeUntil = time.Time{}
+        automaticRelays.badUntil = map[string]time.Time{}
+        return func() {
+                automaticRelays.manifests = previousManifests
+                automaticRelays.client = previousClient
+                automaticRelays.transport = previousTransport
+                automaticRelays.urls = previousURLs
+                automaticRelays.refreshAt = previousRefresh
+                automaticRelays.active = previousActive
+                automaticRelays.activeUntil = previousActiveUntil
+                automaticRelays.badUntil = previousBad
+        }
+}
+
+// testProxyPassJWT builds a minimal signed-shape JWT string the pass
+// parser accepts (header.payload.signature, each base64URL).
+func testProxyPassJWT(t *testing.T) string {
+        t.Helper()
+        enc := base64.RawURLEncoding
