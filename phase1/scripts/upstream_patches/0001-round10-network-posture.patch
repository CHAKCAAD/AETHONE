+// TestHelloSplitModes (the reference's hellosplit_test.go essentials): a
+// TLS client whose connection is wrapped must still complete the
+// handshake against a real TLS server in EVERY mode — the server gets
+// the same bytes, only the segment boundaries differ.
+func TestHelloSplitModes(t *testing.T) {
+        previous := HelloSplit()
+        t.Cleanup(func() { SetHelloSplit(previous) })
+
+        for _, way := range []string{HelloSplitOff, HelloSplitFirstByte, HelloSplitSNI, HelloSplitRecord} {
+                SetHelloSplit(way)
+                srv := newHelloSplitTestServer(t)
+                var wg sync.WaitGroup
+                for i := 0; i < 4; i++ {
+                        wg.Add(1)
+                        go func() {
+                                defer wg.Done()
+                                raw, err := net.DialTimeout("tcp", srv.addr, 5*time.Second)
+                                if err != nil {
+                                        t.Errorf("way=%s dial: %v", way, err)
+                                        return
+                                }
+                                defer raw.Close()
+                                conn := tls.Client(WrapHelloSplit(raw), &tls.Config{
+                                        InsecureSkipVerify: true,
+                                        ServerName:         "example.test",
+                                        NextProtos:         []string{"http/1.1"},
+                                })
+                                if err := conn.Handshake(); err != nil {
+                                        t.Errorf("way=%s handshake: %v", way, err)
+                                        return
+                                }
+                                if _, err := conn.Write([]byte("ping")); err != nil {
+                                        t.Errorf("way=%s write: %v", way, err)
+                                }
+                                buf := make([]byte, 4)
+                                _ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+                                if _, err := io.ReadFull(conn, buf); err != nil {
+                                        t.Errorf("way=%s read: %v", way, err)
+                                }
+                        }()
+                }
+                wg.Wait()
+        }
+}
+
+// TestHelloSplitSNISegments: the sni way cuts INSIDE the server name —
+// the first segment ends after exactly one byte of it.
+func TestHelloSplitSNISegments(t *testing.T) {
+        hello := buildTestClientHello(t, "example.test")
+        segments, err := helloSplitSegments(hello, HelloSplitSNI)
+        if err != nil {
+                t.Fatal(err)
+        }
+        if len(segments) != 3 {
+                t.Fatalf("segments = %d, want 3", len(segments))
+        }
+        var joined []byte
+        for _, s := range segments {
+                joined = append(joined, s...)
+        }
+        if !bytes.Equal(joined, hello) {
+                t.Fatal("the segments must join back to the whole hello")
+        }
+        // The cut is after the name's first letter: the first segment's tail
+        // is 'e' of example.test, and the second segment is exactly one byte.
+        if len(segments[1]) != 1 || segments[1][0] != 'e' {
+                t.Fatalf("the sni cut must fall inside the name: seg1=%q", segments[1])
+        }
+}
+
+// TestHelloSplitRecords: the record way makes TWO records whose bodies
+// join back to the one record's body.
+func TestHelloSplitRecords(t *testing.T) {
+        hello := buildTestClientHello(t, "example.test")
+        out, err := helloSplitRecords(hello)
+        if err != nil {
+                t.Fatal(err)
+        }
+        if len(out) <= len(hello) {
+                t.Fatalf("two records must be longer than one: %d <= %d", len(out), len(hello))
+        }
+        const headerLen = 5
+        total := int(out[3])<<8 | int(out[4])
+        firstBody := out[headerLen : headerLen+total]
+        second := out[headerLen+total:]
+        secondLen := int(second[3])<<8 | int(second[4])
+        secondBody := second[headerLen : headerLen+secondLen]
+        joined := append(append([]byte{}, firstBody...), secondBody...)
+        if !bytes.Equal(joined, hello[headerLen:]) {
+                t.Fatal("the two record bodies must join back to the one body")
+        }
+}
+
+// TestSetHelloSplitIgnoresUnknown: an unknown mode never takes effect.
+func TestSetHelloSplitIgnoresUnknown(t *testing.T) {
+        previous := HelloSplit()
+        t.Cleanup(func() { SetHelloSplit(previous) })
+        SetHelloSplit(HelloSplitSNI)
+        SetHelloSplit("nonsense")
+        if HelloSplit() != HelloSplitSNI {
+                t.Fatalf("an unknown mode changed the pick to %q", HelloSplit())
+        }
+        if !ValidHelloSplit("") || !ValidHelloSplit(HelloSplitRecord) || ValidHelloSplit("nope") {
+                t.Fatal("ValidHelloSplit disagrees with the choices")
+        }
+}
+
+// buildTestClientHello builds ONE whole ClientHello record the way
+// crypto/tls writes it (a single Write).
+func buildTestClientHello(t *testing.T, name string) []byte {
+        t.Helper()
+        srv := newHelloSplitTestServer(t)
+        raw, err := net.DialTimeout("tcp", srv.addr, 5*time.Second)
+        if err != nil {
+                t.Fatal(err)
+        }
+        defer raw.Close()
+
+        captured := make(chan []byte, 1)
+        srv.capture = captured
+
+        conn := tls.Client(WrapHelloSplit(raw), &tls.Config{
+                InsecureSkipVerify: true,
+                ServerName:         name,
+                NextProtos:         []string{"http/1.1"},
+        })
+        if err := conn.Handshake(); err != nil {
+                t.Fatalf("handshake under off: %v", err)
+        }
+        SetHelloSplit(HelloSplitOff)
+        select {
+        case hello := <-captured:
+                if !isClientHello(hello) {
+                        t.Fatal("the captured write is not a ClientHello record")
+                }
+                return hello
+        case <-time.After(5 * time.Second):
+                t.Fatal("no ClientHello captured")
+                return nil
+        }
+}
+
+type helloSplitTestServer struct {
+        addr    string
+        capture chan []byte
+}
+
+// newHelloSplitTestServer runs a TLS echo server on loopback; when
+// capture is set, the FIRST write of each connection is copied there.
+func newHelloSplitTestServer(t *testing.T) *helloSplitTestServer {
+        t.Helper()
+        cert, key := selfSignHelloSplitCert(t)
+        config := &tls.Config{
+                Certificates: []tls.Certificate{cert},
+                NextProtos:   []string{"http/1.1"},
+        }
+        ln, err := net.Listen("tcp", "127.0.0.1:0")
+        if err != nil {
+                t.Fatal(err)
+        }
+        srv := &helloSplitTestServer{addr: ln.Addr().String()}
+        t.Cleanup(func() { _ = ln.Close() })
+        go func() {
+                for {
+                        conn, err := ln.Accept()
+                        if err != nil {
+                                return
+                        }
+                        go func(c net.Conn) {
+                                defer c.Close()
+                                // Capture the first write raw (before TLS eats it).
+                                reader := bufio.NewReader(c)
+                                peek, _ := reader.Peek(5)
+                                if srv.capture != nil && len(peek) == 5 && peek[0] == 0x16 {
+                                        full, _ := reader.Peek(5 + int(peek[3])<<8 + int(peek[4]))
+                                        if len(full) > 0 {
+                                                select {
+                                                case srv.capture <- append([]byte(nil), full...):
+                                                default:
+                                                }
+                                        }
+                                }
+                                tlsConn := tls.Server(&bufConnWrapper{Conn: c, r: reader}, config)
+                                if err := tlsConn.Handshake(); err != nil {
+                                        return
+                                }
+                                buf := make([]byte, 4)
+                                _ = tlsConn.SetReadDeadline(time.Now().Add(10 * time.Second))
+                                if _, err := io.ReadFull(tlsConn, buf); err != nil {
+                                        return
+                                }
+                                _, _ = tlsConn.Write(buf)
+                        }(conn)
+                }
+        }()
+        _ = key
+        return srv
+}
+
+// bufConnWrapper lets tls.Server read from the buffered reader while
+// owning the real connection.
+type bufConnWrapper struct {
+        net.Conn
+        r *bufio.Reader
+}
+
+func (b *bufConnWrapper) Read(p []byte) (int, error) { return b.r.Read(p) }
+
+func selfSignHelloSplitCert(t *testing.T) (tls.Certificate, *ecdsa.PrivateKey) {
+        t.Helper()
+        key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+        if err != nil {
+                t.Fatal(err)
+        }
+        tmpl := &x509.Certificate{
+                SerialNumber: big.NewInt(1),
+                Subject:      pkix.Name{CommonName: "example.test"},
+                DNSNames:     []string{"example.test"},
+                NotBefore:    time.Now().Add(-time.Hour),
+                NotAfter:     time.Now().Add(time.Hour),
+        }
+        der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+        if err != nil {
+                t.Fatal(err)
+        }
+        return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}, key
+}
