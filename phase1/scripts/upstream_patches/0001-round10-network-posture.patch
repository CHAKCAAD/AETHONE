diff -ruN a/hellosplit.go patched/hellosplit.go
--- a/hellosplit.go	1970-01-01 00:00:00.000000000 +0000
+++ b/hellosplit.go	2026-11-16 08:30:05.070318609 +0000
@@ -0,0 +1,223 @@
+package vpnclient
+
+// hellosplit sends the TLS ClientHello of this program's connections
+// to Mozilla across several TCP segments, so that a network filtering by
+// server name, whose inspection does not put segments back together, does
+// not read the name. The server gets the same bytes and the name stays
+// the real one (Mozilla's proxy refuses any other). It can also go out as
+// two TLS records, for an inspection that does put segments together but
+// reads only the first record.
+//
+// Ported verbatim from the reference project (arman-vpn-client,
+// core/internal/hellosplit) — the owner's decree «از پروژه
+// arman-vpn-client الگو بگیر و مشکل رو حل کن» made its whole network
+// posture the pattern, and this is the piece round 9 missed: the SNI-based
+// filter drops the reference's direct connections too until the hello is
+// split, which is why the direct sign-in and the DNS answers kept failing
+// while the reference worked.
+
+import (
+	"encoding/binary"
+	"errors"
+	"net"
+	"sync/atomic"
+)
+
+// The helloSplit choices, exactly the reference's network.hello_split.
+// SNI cuts the name after its first letter; FirstByte cuts the record
+// after its first byte; Record makes two records of the hello, cut after
+// the name's first letter.
+const (
+	HelloSplitOff        = "off"
+	HelloSplitSNI        = "sni"
+	HelloSplitFirstByte  = "first-byte"
+	HelloSplitRecord     = "record"
+)
+
+// helloSplitConfigured is the process-wide way a new connection sends its
+// ClientHello; nil means Off (the reference's own default — the roles set
+// it from their config line).
+var helloSplitConfigured atomic.Pointer[string]
+
+// ValidHelloSplit reports whether mode is a choice (empty means Off).
+func ValidHelloSplit(mode string) bool {
+	switch mode {
+	case "", HelloSplitOff, HelloSplitSNI, HelloSplitFirstByte, HelloSplitRecord:
+		return true
+	}
+	return false
+}
+
+// SetHelloSplit installs the way for the connections opened from now on.
+// An unknown mode is ignored (the previous one stays).
+func SetHelloSplit(mode string) {
+	if !ValidHelloSplit(mode) {
+		return
+	}
+	if mode == "" {
+		mode = HelloSplitOff
+	}
+	helloSplitConfigured.Store(&mode)
+}
+
+// helloSplitCurrent is the way a new connection sends its ClientHello.
+func helloSplitCurrent() string {
+	if mode := helloSplitConfigured.Load(); mode != nil {
+		return *mode
+	}
+	return HelloSplitOff
+}
+
+// HelloSplit reports the installed way ("" when none was set).
+func HelloSplit() string {
+	if mode := helloSplitConfigured.Load(); mode != nil {
+		return *mode
+	}
+	return ""
+}
+
+// WrapHelloSplit returns conn, a new connection about to start TLS,
+// sending its ClientHello the chosen way. Anything that is not a
+// ClientHello passes untouched.
+func WrapHelloSplit(conn net.Conn) net.Conn {
+	way := helloSplitCurrent()
+	if way == HelloSplitOff {
+		return conn
+	}
+	return &splitConn{Conn: conn, way: way}
+}
+
+// splitConn splits the ClientHellos written to it.
+type splitConn struct {
+	net.Conn
+	way string
+}
+
+func (c *splitConn) Write(p []byte) (int, error) {
+	if !isClientHello(p) {
+		return c.Conn.Write(p)
+	}
+	if c.way == HelloSplitRecord {
+		return c.writeRecords(p)
+	}
+	segments, err := helloSplitSegments(p, c.way)
+	if err != nil {
+		// Not a hello we can cut: it goes out whole.
+		return c.Conn.Write(p)
+	}
+	total := 0
+	for _, segment := range segments {
+		n, err := c.Conn.Write(segment)
+		total += n
+		if err != nil {
+			return total, err
+		}
+	}
+	return total, nil
+}
+
+// writeRecords sends p, a whole ClientHello record, as two records. It is
+// longer on the wire than p, and reports p's length: TLS counts what it
+// gave.
+func (c *splitConn) writeRecords(p []byte) (int, error) {
+	out, err := helloSplitRecords(p)
+	if err != nil {
+		return c.Conn.Write(p)
+	}
+	if _, err := c.Conn.Write(out); err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+// helloSplitRecords makes two TLS records of p, a whole ClientHello
+// record, cut after the first letter of the server's name.
+func helloSplitRecords(p []byte) ([]byte, error) {
+	const headerLen = 5
+	if int(binary.BigEndian.Uint16(p[3:])) != len(p)-headerLen {
+		return nil, errors.New("not one whole record")
+	}
+	start, err := helloSplitNameOffset(p)
+	if err != nil {
+		return nil, err
+	}
+	cut := start + 1
+	out := make([]byte, 0, len(p)+headerLen)
+	out = append(out, p[:3]...)
+	out = binary.BigEndian.AppendUint16(out, uint16(cut-headerLen))
+	out = append(out, p[headerLen:cut]...)
+	out = append(out, p[:3]...)
+	out = binary.BigEndian.AppendUint16(out, uint16(len(p)-cut))
+	return append(out, p[cut:]...), nil
+}
+
+// isClientHello reports whether p starts a TLS handshake record holding a
+// ClientHello.
+func isClientHello(p []byte) bool {
+	return len(p) > 5 && p[0] == 0x16 && p[1] == 0x03 && p[5] == 0x01
+}
+
+// helloSplitSegments cuts p, a whole ClientHello record, the given way.
+func helloSplitSegments(p []byte, way string) ([][]byte, error) {
+	switch way {
+	case HelloSplitFirstByte:
+		return [][]byte{p[:1], p[1:]}, nil
+	case HelloSplitSNI:
+		start, err := helloSplitNameOffset(p)
+		if err != nil {
+			return nil, err
+		}
+		return [][]byte{p[:start], p[start : start+1], p[start+1:]}, nil
+	}
+	return nil, errors.New("unknown way: " + way)
+}
+
+// helloSplitNameOffset finds the first byte of the server name in p, a
+// ClientHello record. A hello without a name, or one that does not parse,
+// is an error.
+func helloSplitNameOffset(p []byte) (int, error) {
+	errBad := errors.New("not a ClientHello with a server name")
+	// Record header (5), handshake header (4), version (2), random (32).
+	at := 5 + 4 + 2 + 32
+	skip := func(lengthBytes int) bool {
+		if at+lengthBytes > len(p) {
+			return false
+		}
+		n := 0
+		for _, b := range p[at : at+lengthBytes] {
+			n = n<<8 | int(b)
+		}
+		at += lengthBytes + n
+		return at <= len(p)
+	}
+	// Session ID, cipher suites, compression methods.
+	if !skip(1) || !skip(2) || !skip(1) || at+2 > len(p) {
+		return 0, errBad
+	}
+	end := at + 2 + int(binary.BigEndian.Uint16(p[at:]))
+	at += 2
+	if end > len(p) {
+		end = len(p)
+	}
+	for at+4 <= end {
+		kind := binary.BigEndian.Uint16(p[at:])
+		size := int(binary.BigEndian.Uint16(p[at+2:]))
+		body := at + 4
+		if body+size > end {
+			return 0, errBad
+		}
+		if kind == 0 {
+			// server_name: list length (2), name type (1), name length (2).
+			if size < 6 || p[body+2] != 0 {
+				return 0, errBad
+			}
+			nameLen := int(binary.BigEndian.Uint16(p[body+3:]))
+			if nameLen == 0 || body+5+nameLen > end {
+				return 0, errBad
+			}
+			return body + 5, nil
+		}
+		at = body + size
+	}
+	return 0, errBad
+}
