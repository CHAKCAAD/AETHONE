<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.0 — THE HOME SCREEN WIDGET LAYOUT: the app's own design
     language (the dark #0F1511 card, the brand A-mark, the power
     glyph). The body opens the app; the power slot toggles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <!-- The brand A-mark (the status-bar icon's own vector, tinted
         white here — the mark on the dark card). -->
    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="AETHONE"
        android:src="@drawable/ic_stat_aethone"
        android:tint="@color/widgetInk" />

    <!-- The wordmark + the honest state line. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AETHONE"
            android:textColor="@color/widgetInk"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_state_disconnected"
            android:textColor="@color/widgetMuted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- The power toggle slot (the app's own Off glyph family). -->
    <FrameLayout
        android:id="@+id/widget_power_slot"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_power_bg">

        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_toggle_desc"
            android:src="@drawable/ic_widget_power"
            android:tint="@color/widgetInk" />
    </FrameLayout>
</LinearLayout>
