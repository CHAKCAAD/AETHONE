<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.1 — the phone home-screen widget (owner: «ویجت صفحه اصلی گوشی»).
     Framework views only (RemoteViews restriction). The brand's night card
     (#0F1511, the pixel-measured cardDark) with the A-mark, a live status
     line and one big action pill; state is filled by AethoneHomeWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <!-- the brand row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_stat_aethone"
            android:contentDescription="@string/widget_label"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_label"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>
    </LinearLayout>

    <!-- the status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/widget_dot_off"
            android:contentDescription="@string/widget_status_idle"/>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_status_idle"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- the action pill -->
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/widget_action_connect"
        android:textColor="#FF04150E"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn_connect"
        android:maxLines="1"/>
</LinearLayout>
