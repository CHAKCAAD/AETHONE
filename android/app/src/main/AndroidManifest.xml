<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- UI-step packaging (v4.9) permissions + the M2 VPN plumbing that
         SHIPPED TOGETHER WITH the real VpnService implementation (honesty
         rule: no permission is declared before the code that needs it). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- M2: the tunnel — foreground service + VPN consent + its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Family Shield (phase 1): backup rules only EXCLUDE the shield store and
         PIN state (res/xml/backup_rules.xml, data_extraction_rules.xml); all
         other app data keeps its existing backup behaviour. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- M2 — the whole-device tunnel service. The system binds via
             BIND_VPN_SERVICE; specialUse is the only honest foreground type
             for a VPN tunnel on Android 14+ (subtype declared below). -->
        <service
            android:name=".AethoneVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn-tunnel"/>
        </service>
        <!-- v4.19 (#7) — the proxy-mode process hold: the Aether core runs
             IN-PROCESS, so without this foreground service swiping the app
             away killed the process and the proxy session with it. It owns
             nothing about the core; it only keeps the process alive while a
             proxy session is up (started/stopped by the engine adapter). -->
        <service
            android:name=".CoreHoldService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="core-holder"/>
        </service>
        <!-- v2.1.0 (the owner's decree, 2026-11-17: «برای بخش کنترل سنتر
             گوشی هم ویجت اضافه کن») — THE QUICK SETTINGS TILE: the brand
             mark with the honest service state; tap disconnects a LIVE
             tunnel natively (the service's own ACTION_DISCONNECT) or opens
             the app to connect. -->
        <service
            android:name=".AethoneTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_stat_aethone"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false"/>
        </service>
        <!-- v2.1.0 — THE HOME SCREEN WIDGET: the connection card (the app's
             own mark + the power glyph); the body opens the app, the power
             slot toggles like the tile. State is pushed by the service
             itself on start/stop (never a stale reading). -->
        <receiver
            android:name=".AethoneWidgetProvider"
            android:label="@string/tile_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aethone_widget_info"/>
        </receiver>
        <!-- v2.1.0 — the widget power button's toggle receiver. -->
        <receiver
            android:name=".WidgetToggleReceiver"
            android:exported="false"/>
        <!-- v1.0.1 (motion-line merge) — THE 4×2 BRAND-DARK HOME WIDGET
             (AethoneHomeWidget): the status line + one big action, pushed
             by the holder services and the Dart walk; no periodic alarm. -->
        <receiver
            android:name=".AethoneHomeWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aethone_home_widget_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- v4.42 — the per-app tunneling picker's visibility (the
             owner's report: «همه برنامه های گوشی نمایش داده نمیشه»):
             on Android 11+ package-visibility filtering applies to
             queryIntentActivities too — without this launcher-intent
             declaration the picker only ever saw a small automatic-
             visibility subset. With it, EVERY launchable app is visible
             (the documented launcher/app-picker pattern; no
             QUERY_ALL_PACKAGES needed — that permission is restricted
             on Play and this app is not a device-admin tool). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
