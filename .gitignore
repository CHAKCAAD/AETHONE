# =============================================================================
# AETHONE .gitignore (ci-bootstrap/v4.4)
# Patterns are deliberately scoped/anchored so that NOTHING on this branch
# (native/, design/, docs/, evidence/, scripts/) is ignored. Machine-verified:
# tracked file count == on-disk file count (see evidence/transfer/).
# =============================================================================

# --- Credentials & signing material (NEVER commit) ---
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.keytab
key.properties
**/key.properties
keystore/
secrets/
*.secrets

# --- Flutter / Dart (root-anchored — applies when the app source lands here) ---
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/coverage/

# --- Android app build outputs (root-anchored) ---
/android/.gradle/
/android/captures/
/android/gradlew
/android/gradlew.bat
/android/local.properties
/android/**/build/
/android/.cxx/
/android/*.iml
# M2: CI-staged native cores (jniLibs are copied from the native-* artifacts
# by the android-apk job — binaries are never committed).
/android/app/src/main/jniLibs/

# --- IDE / OS noise ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- CI outputs (never commit build artifacts) ---
/out/
/.srccache/
/.tools/

# --- v4.36 desktop round: local native/engine build scratch (never commit) ---
.out-desktop/
.srccache*/
# local validation bundles staged by hand
/native-out/

# PHASE-2 (firefox-vpn rebuild): the pinned upstream core is FETCHED,
# never committed (no license at the pin — see phase1/fxv/ORIGIN.md);
# phase1/scripts/fetch_upstream.sh + the SHA256 manifest pin it.
/phase1/firefox-vpn-client/

# PHASE-2 rebuild: engine build outputs — binaries never enter git;
# the manifest + inspection evidence stay (the deploy check reads them).
/phase1/build/android/**/libfirefoxvpn.so
/phase1/build/host/libfirefoxvpn
phase1/build/SHA256SUMS.txt.bak
