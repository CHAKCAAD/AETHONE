+/// AETHONE Family Shield: the route callback that also receives the native
+/// shield verdict of the flow (flow/shield.zig Verdict.encode; 0 = no shield
+/// snapshot). When installed it is used instead of RouteFn.
+pub const ShieldRouteFn = *const fn (ctx: ?*anyopaque, flow: *const Flow, name: ?[*]const u8, name_len: usize, shield: u32) callconv(.c) u32;
+
+/// AETHONE Family Shield: asked for every live flow after
+/// zeptun_revalidate_flows. Non-zero = abort the flow (TCP RST / UDP close),
+/// 0 = keep it untouched.
+pub const RevalidateFn = *const fn (ctx: ?*anyopaque, flow: *const Flow, name: ?[*]const u8, name_len: usize, shield: u32) callconv(.c) u32;
+
+/// AETHONE traffic analytics: one metered byte report for a proxied flow.
+/// `up` is payload the app sent that zeptun wrote to the flow's SOCKS5
+/// stream; `down` is payload zeptun read from that stream for the app (the
+/// upstream_tx/rx_bytes measuring point, per flow). Both are DELTAS since the
+/// previous report of the same flow; `closed` = 1 on the flow's last report.
+/// `route` is the route the flow was really dialled on (0 = default server,
+/// n = routes[n-1]).
+pub const MeterRecord = extern struct {
+    flow: Flow,
+    route: u8,
+    closed: u8,
+    up: u64,
+    down: u64,
+};
+
+pub const MeterFn = *const fn (ctx: ?*anyopaque, rec: *const MeterRecord) callconv(.c) void;
