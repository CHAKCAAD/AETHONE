+export fn zeptun_set_route_servers(tun: ?*anyopaque, servers: ?[*:0]const u8) callconv(.c) c_int {
+    const h = handleOf(tun) orelse return code(.invalid_argument);
+    if (h.started.load(.acquire)) return code(.already_running);
+    const text = servers orelse return code(.invalid_argument);
+    var list: [zeptun.config.max_routes]zeptun.addr.Endpoint = undefined;
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, std.mem.span(text), ',');
+    while (it.next()) |raw| {
+        const item = std.mem.trim(u8, raw, " ");
+        if (item.len == 0) continue;
+        if (n == list.len) return code(.invalid_argument);
+        list[n] = zeptun.addr.Endpoint.parse(item) catch return code(.invalid_argument);
+        n += 1;
+    }
+    h.engine.setRoutes(list[0..n]) catch return code(.invalid_argument);
+    return code(.ok);
+}
+
+// ---- AETHONE Family Shield ------------------------------------------------
+
+const shield = zeptun.flow.shield;
+
+fn shieldCode(err: shield.Error) c_int {
+    return switch (err) {
+        error.OutOfMemory => code(.out_of_memory),
+        else => code(.config_error),
+    };
+}
+
+/// Validates a shield snapshot completely without installing it.
+export fn zeptun_shield_validate(bytes: ?[*]const u8, len: usize) callconv(.c) c_int {
+    const p = bytes orelse return code(.invalid_argument);
+    _ = shield.Snapshot.parse(p[0..len]) catch |err| return shieldCode(err);
+    return code(.ok);
+}
+
+/// Validates, copies and atomically installs a snapshot (any time, running or
+/// not). NULL / 0 clears the shield. A refused snapshot keeps the previous one.
+export fn zeptun_set_shield_snapshot(tun: ?*anyopaque, bytes: ?[*]const u8, len: usize) callconv(.c) c_int {
+    const h = handleOf(tun) orelse return code(.invalid_argument);
+    const slice: ?[]const u8 = if (bytes) |p| (if (len > 0) p[0..len] else null) else null;
+    h.engine.installShield(slice) catch |err| return shieldCode(err);
+    return code(.ok);
+}
+
+export fn zeptun_set_shield_route_callback(tun: ?*anyopaque, cb: ?zeptun.flow.verdict.ShieldRouteFn, ctx: ?*anyopaque) callconv(.c) c_int {
+    const h = handleOf(tun) orelse return code(.invalid_argument);
+    if (h.started.load(.acquire)) return code(.already_running);
+    h.engine.setShieldRouter(cb, ctx);
+    return code(.ok);
+}
+
+export fn zeptun_set_revalidate_callback(tun: ?*anyopaque, cb: ?zeptun.flow.verdict.RevalidateFn, ctx: ?*anyopaque) callconv(.c) c_int {
+    const h = handleOf(tun) orelse return code(.invalid_argument);
+    if (h.started.load(.acquire)) return code(.already_running);
+    h.engine.setRevalidate(cb, ctx);
+    return code(.ok);
+}
+
+/// Every worker re-checks its live flows on its next loop turn.
+export fn zeptun_revalidate_flows(tun: ?*anyopaque) callconv(.c) c_int {
+    const h = handleOf(tun) orelse return code(.invalid_argument);
+    h.engine.revalidateFlows();
+    return code(.ok);
+}
+
+/// 0 dns_blocked, 1 flow_blocked, 2 flows_killed, 3 swaps, 4 rejected,
+/// 5 generation of the active snapshot, 6 active (0/1).
+export fn zeptun_shield_counter(tun: ?*anyopaque, index: c_int) callconv(.c) i64 {
+    const h = handleOf(tun) orelse return -1;
+    if (index < 0 or index > 6) return -1;
+    return @intCast(h.engine.shield.counter(@enumFromInt(@as(u8, @intCast(index)))));
+}
+
+/// Diagnostics / tests: the encoded verdict for a name (may be NULL) and a
+/// destination address (4 or 16 bytes), 0 when no snapshot is active.
+export fn zeptun_shield_check(tun: ?*anyopaque, name: ?[*]const u8, name_len: usize, dst: ?[*]const u8, dst_len: usize, proto: u8, port: u16) callconv(.c) u32 {
+    const h = handleOf(tun) orelse return 0;
+    const st = &h.engine.shield;
+    defer st.release();
+    const snap = st.acquire() orelse return 0;
+    var buf: [shield.max_name]u8 = undefined;
+    const n: ?[]const u8 = if (name) |p| shield.normalize(p[0..name_len], &buf) else null;
+    const a: addr.Address = if (dst) |p| (if (dst_len == 16) addr.Address.v6(p[0..16].*) else if (dst_len == 4) addr.Address.v4(p[0..4].*) else return 0) else addr.Address.v4(.{ 0, 0, 0, 0 });
+    if (name != null and n == null) {
+        // an un-normalizable name is never on a list: judge it as unknown
+        return snap.checkFlow(null, a, true, proto, port).encode();
+    }
+    return snap.checkFlow(n, a, dst == null, proto, port).encode();
+}
