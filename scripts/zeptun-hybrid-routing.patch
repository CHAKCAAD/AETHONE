+/// AETHONE hybrid routing: a route callback also sees the domain name the
+/// fake-IP table holds for the destination (null when the destination is a
+/// real address). Its answer: 0 = the default server, 16 + i = extra server
+/// i (handler.socks5.routes[i]), 2 = drop, 3 = reject. Anything else is
+/// refused (reject): a route answer can never send a flow direct.
+pub const RouteFn = *const fn (ctx: ?*anyopaque, flow: *const Flow, name: ?[*]const u8, name_len: usize) callconv(.c) u32;
+
+pub const route_base: u32 = 16;
