diff --git a/src/jni/zeptun_jni.c b/src/jni/zeptun_jni.c
index ee56f42..2f4cf1c 100644
--- a/src/jni/zeptun_jni.c
+++ b/src/jni/zeptun_jni.c
@@ -15,9 +15,68 @@ typedef struct {
     jmethodID protect;
     pthread_t thread;
     int running;
+    /* AETHONE hybrid routing */
+    jclass route_class;
+    jmethodID route;
 } Context;
 
 static Context context;
+static pthread_key_t route_key;
+static pthread_once_t route_once = PTHREAD_ONCE_INIT;
+
+static void detach_route_thread(void *vm) {
+    if (vm != NULL) (*(JavaVM *)vm)->DetachCurrentThread((JavaVM *)vm);
+}
+
+static void make_route_key(void) {
+    pthread_key_create(&route_key, detach_route_thread);
+}
+
+/* Engine threads that ask for routes stay attached for their lifetime (one
+ * attach per worker, not per flow); the key's destructor detaches them. */
+static JNIEnv *route_env(void) {
+    JNIEnv *env = NULL;
+    if ((*context.vm)->GetEnv(context.vm, (void **)&env, JNI_VERSION_1_6) == JNI_OK) return env;
+    if ((*context.vm)->AttachCurrentThread(context.vm, &env, NULL) != JNI_OK) return NULL;
+    pthread_once(&route_once, make_route_key);
+    pthread_setspecific(route_key, context.vm);
+    return env;
+}
+
+static uint32_t route_flow(void *ctx, const ZeptunFlow *flow, const char *name, size_t name_len) {
+    (void)ctx;
+    if (context.vm == NULL || context.route_class == NULL || context.route == NULL) return ZEPTUN_ROUTE_DEFAULT;
+    JNIEnv *env = route_env();
+    if (env == NULL) return ZEPTUN_FLOW_REJECT;
+    jint alen = flow->family == 6 ? 16 : 4;
+    jbyteArray src = (*env)->NewByteArray(env, alen);
+    jbyteArray dst = (*env)->NewByteArray(env, alen);
+    jstring host = NULL;
+    uint32_t answer = ZEPTUN_FLOW_REJECT;
+    if (src == NULL || dst == NULL) goto done;
+    (*env)->SetByteArrayRegion(env, src, 0, alen, (const jbyte *)flow->source);
+    (*env)->SetByteArrayRegion(env, dst, 0, alen, (const jbyte *)flow->destination);
+    if (name != NULL && name_len > 0 && name_len < 256) {
+        char buf[256];
+        memcpy(buf, name, name_len);
+        buf[name_len] = 0;
+        host = (*env)->NewStringUTF(env, buf);
+    }
+    jint v = (*env)->CallStaticIntMethod(env, context.route_class, context.route,
+                                         (jint)flow->protocol, (jint)flow->family,
+                                         src, (jint)flow->source_port, dst, (jint)flow->destination_port, host);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionClear(env);
+        goto done;
+    }
+    answer = (uint32_t)v;
+done:
+    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+    if (src != NULL) (*env)->DeleteLocalRef(env, src);
+    if (dst != NULL) (*env)->DeleteLocalRef(env, dst);
+    if (host != NULL) (*env)->DeleteLocalRef(env, host);
+    return answer;
+}
 
