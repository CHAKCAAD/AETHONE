new file mode 100644
index 0000000..482c391
--- /dev/null
+++ b/src/flow/shield.zig
@@ -0,0 +1,1036 @@
+//! AETHONE Family Shield — the native policy matcher.
+//!
+//! A read-only binary snapshot (built and signed off by the Android app, see
+//! docs/family-shield-architecture.md in AETHONE) holds every domain rule and
+//! IP/CIDR rule of the active profile. zeptun consults it
+//!   * at DNS time (`dns.answerShield`): a blocked name gets NXDOMAIN without
+//!     SOA, before any fake-IP slot is taken and before any upstream query;
+//!   * at flow open (TCP SYN / first UDP datagram): the fake-IP name or the
+//!     real destination address is checked again, so a cached fake IP can not
+//!     bypass the DNS-time block, and the verdict is handed to the route
+//!     callback (the app layer adds per-app blocks);
+//!   * on `zeptun_revalidate_flows`: every live flow is re-checked against the
+//!     new snapshot and the newly blocked ones are aborted.
+//!
+//! Snapshot format v1 (little endian; the Kotlin builder ShieldSnapshot.kt
+//! writes exactly this):
+//!
+//!   header (128 bytes)
+//!     0  magic "AETHSHLD"            8  version u16 = 1   10 header_len u16 = 128
+//!     12 flags u32                   16 total_len u32     20 generation u32
+//!     24 enabled_cats u64            32 mandatory_cats u64
+//!     40 allow_cats u64              48 domain_count u32  52 bucket_count u32
+//!     56 v4_count u32                60 v6_count u32      64 strings_len u32
+//!     68 profile u32                 72..96 reserved (zero)
+//!     96 sha256 (32 bytes) of the whole file with these 32 bytes zeroed
+//!   entries  domain_count x 40: hash u64 (FNV-1a 64 of the name), str_off u32,
+//!            str_len u16, reserved u16, self_flags u32, sub_flags u32,
+//!            self_cats u64, sub_cats u64
+//!   buckets  bucket_count x u32 (entry index + 1, 0 = empty; linear probing
+//!            from hash & (bucket_count - 1))
+//!   v4       v4_count x 24: addr[4] (network order), prefix u8, pad[3],
+//!            flags u32, pad u32, cats u64 — sorted by (prefix, addr), unique
+//!   v6       v6_count x 32: addr[16], prefix u8, pad[3], flags u32, cats u64
+//!   strings  strings_len bytes (normalized names: lowercase ASCII / punycode)
+//!
+//! "self" bits apply to the name itself, "sub" bits to every strict subdomain
+//! (label boundary: `example.com` never matches `notexample.com`). An exact
+//! rule sets self only, a wildcard `*.example.com` sub only, a root rule
+//! (`example.com` and everything under it) both.
+const std = @import("std");
+const addr = @import("../addr.zig");
+
+pub const magic = "AETHSHLD";
+pub const version: u16 = 1;
+pub const header_len: usize = 128;
+pub const entry_len: usize = 40;
+pub const v4_len: usize = 24;
+pub const v6_len: usize = 32;
+pub const max_name = 253;
+
+/// header flags
+pub const flag_unknown_block: u32 = 1 << 0;
+pub const flag_strict_dot: u32 = 1 << 1;
+pub const flag_strict_quic: u32 = 1 << 2;
+pub const flag_strict_direct_ip: u32 = 1 << 3;
+pub const flag_strict_alt_dns: u32 = 1 << 4;
+const known_header_flags: u32 = 0x1f;
+
+/// rule flags
+pub const rule_parent_block: u32 = 1 << 0;
+pub const rule_parent_allow: u32 = 1 << 1;
+const known_rule_flags: u32 = 0x3;
+
+/// Rule levels (the owner's priority order; 3 = app restrictions lives in the
+/// app layer because it needs the flow's owner uid).
+pub const Level = enum(u8) {
+    none = 0,
+    mandatory = 1,
+    parent_block = 2,
+    app = 3,
+    category = 4,
+    parent_allow = 5,
+    unknown = 6,
+    strict = 7,
+};
+
+pub const Verdict = struct {
+    block: bool = false,
+    level: Level = .none,
+    /// category bit index + 1 (0 = none)
+    category: u8 = 0,
+
+    pub const allow: Verdict = .{};
+
+    /// The u32 handed to the route / revalidate callbacks:
+    /// bit 31 = a snapshot is active, bits 0..7 = 1 block / 0 allow,
+    /// bits 8..15 = level, bits 16..23 = category index + 1.
+    pub fn encode(v: Verdict) u32 {
+        return (@as(u32, 1) << 31) | @as(u32, @intFromBool(v.block)) | (@as(u32, @intFromEnum(v.level)) << 8) | (@as(u32, v.category) << 16);
+    }
+};
+
+pub const Error = error{
+    TooShort,
+    BadMagic,
+    BadVersion,
+    BadHeader,
+    BadLength,
+    BadChecksum,
+    BadEntry,
+    BadBuckets,
+    BadCidr,
+    OutOfMemory,
+};
+
+pub fn fnv1a64(s: []const u8) u64 {
+    var h: u64 = 0xcbf29ce484222325;
+    for (s) |c| {
+        h ^= c;
+        h *%= 0x100000001b3;
+    }
+    return h;
+}
+
+inline fn rd16(b: []const u8, off: usize) u16 {
+    return std.mem.readInt(u16, b[off..][0..2], .little);
+}
+inline fn rd32(b: []const u8, off: usize) u32 {
+    return std.mem.readInt(u32, b[off..][0..4], .little);
+}
+inline fn rd64(b: []const u8, off: usize) u64 {
+    return std.mem.readInt(u64, b[off..][0..8], .little);
+}
+
+fn validChar(c: u8) bool {
+    return (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '-' or c == '_';
+}
+
+/// A normalized name: 1..253 bytes, labels of 1..63 [a-z0-9-_], dot separated.
+pub fn validName(s: []const u8) bool {
+    if (s.len == 0 or s.len > max_name) return false;
+    var label: usize = 0;
+    for (s) |c| {
+        if (c == '.') {
+            if (label == 0) return false;
+            label = 0;
+            continue;
+        }
+        if (!validChar(c)) return false;
+        label += 1;
+        if (label > 63) return false;
+    }
+    return label != 0;
+}
+
+/// A parsed, fully validated snapshot. Read only; never mutated after load.
+pub const Snapshot = struct {
+    bytes: []const u8,
+    flags: u32,
+    generation: u32,
+    enabled: u64,
+    mandatory: u64,
+    allow_cats: u64,
+    domains: u32,
+    buckets: u32,
+    v4: u32,
+    v6: u32,
+    entries_off: usize,
+    buckets_off: usize,
+    v4_off: usize,
+    v6_off: usize,
+    strings_off: usize,
+    strings_len: usize,
+
+    pub fn parse(b: []const u8) Error!Snapshot {
+        if (b.len < header_len) return error.TooShort;
+        if (!std.mem.eql(u8, b[0..8], magic)) return error.BadMagic;
+        if (rd16(b, 8) != version) return error.BadVersion;
+        if (rd16(b, 10) != header_len) return error.BadHeader;
+        const flags = rd32(b, 12);
+        if (flags & ~known_header_flags != 0) return error.BadHeader;
+        for (b[72..96]) |z| if (z != 0) return error.BadHeader;
+        if (rd32(b, 16) != b.len) return error.BadLength;
+        const domains = rd32(b, 48);
+        const buckets = rd32(b, 52);
+        const v4 = rd32(b, 56);
+        const v6 = rd32(b, 60);
+        const strings_len = rd32(b, 64);
+        if (buckets == 0 or !std.math.isPowerOfTwo(buckets)) return error.BadBuckets;
+        if (@as(u64, domains) >= buckets) return error.BadBuckets;
+        const total: u64 = header_len + @as(u64, domains) * entry_len + @as(u64, buckets) * 4 + @as(u64, v4) * v4_len + @as(u64, v6) * v6_len + strings_len;
+        if (total != b.len) return error.BadLength;
+        // checksum: sha256 of the file with its checksum field zeroed
+        var h = std.crypto.hash.sha2.Sha256.init(.{});
+        h.update(b[0..96]);
+        h.update(&([_]u8{0} ** 32));
+        h.update(b[header_len..]);
+        var digest: [32]u8 = undefined;
+        h.final(&digest);
+        if (!std.mem.eql(u8, &digest, b[96..128])) return error.BadChecksum;
+        const entries_off = header_len;
+        const buckets_off = entries_off + @as(usize, domains) * entry_len;
+        const v4_off = buckets_off + @as(usize, buckets) * 4;
+        const v6_off = v4_off + @as(usize, v4) * v4_len;
+        const strings_off = v6_off + @as(usize, v6) * v6_len;
+        const s: Snapshot = .{
+            .bytes = b,
+            .flags = flags,
+            .generation = rd32(b, 20),
+            .enabled = rd64(b, 24),
+            .mandatory = rd64(b, 32),
+            .allow_cats = rd64(b, 40),
+            .domains = domains,
+            .buckets = buckets,
+            .v4 = v4,
+            .v6 = v6,
+            .entries_off = entries_off,
+            .buckets_off = buckets_off,
+            .v4_off = v4_off,
+            .v6_off = v6_off,
+            .strings_off = strings_off,
+            .strings_len = strings_len,
+        };
+        try s.validateBody();
+        return s;
+    }
+
+    fn validateBody(s: *const Snapshot) Error!void {
+        const b = s.bytes;
+        // every entry: sane string, matching hash, known flags, reachable by
+        // probing, and unique (probing finds this very entry)
+        var i: u32 = 0;
+        while (i < s.domains) : (i += 1) {
+            const e = s.entries_off + @as(usize, i) * entry_len;
+            const off = rd32(b, e + 8);
+            const len = rd16(b, e + 12);
+            if (rd16(b, e + 14) != 0) return error.BadEntry;
+            if (@as(u64, off) + len > s.strings_len) return error.BadEntry;
+            const name = b[s.strings_off + off ..][0..len];
+            if (!validName(name)) return error.BadEntry;
+            if (rd64(b, e) != fnv1a64(name)) return error.BadEntry;
+            if ((rd32(b, e + 16) | rd32(b, e + 20)) & ~known_rule_flags != 0) return error.BadEntry;
+            if (s.find(name) != i) return error.BadEntry;
+        }
+        var used: u32 = 0;
+        var k: u32 = 0;
+        while (k < s.buckets) : (k += 1) {
+            const v = rd32(b, s.buckets_off + @as(usize, k) * 4);
+            if (v == 0) continue;
+            if (v > s.domains) return error.BadBuckets;
+            used += 1;
+        }
+        if (used != s.domains) return error.BadBuckets;
+        try s.validateCidrs(false);
+        try s.validateCidrs(true);
+    }
+
+    fn validateCidrs(s: *const Snapshot, v6: bool) Error!void {
+        const b = s.bytes;
+        const n = if (v6) s.v6 else s.v4;
+        const rl: usize = if (v6) v6_len else v4_len;
+        const al: usize = if (v6) 16 else 4;
+        const base = if (v6) s.v6_off else s.v4_off;
+        var prev: ?[]const u8 = null;
+        var prev_prefix: u8 = 0;
+        var i: u32 = 0;
+        while (i < n) : (i += 1) {
+            const r = base + @as(usize, i) * rl;
+            const a = b[r..][0..al];
+            const prefix = b[r + al];
+            if (prefix > al * 8) return error.BadCidr;
+            for (b[r + al + 1 .. r + al + 4]) |z| if (z != 0) return error.BadCidr;
+            const flags = rd32(b, r + al + 4);
+            if (flags & ~known_rule_flags != 0) return error.BadCidr;
+            if (!v6 and rd32(b, r + 12) != 0) return error.BadCidr;
+            // host bits must be zero
+            var bit: usize = prefix;
+            while (bit < al * 8) : (bit += 1) {
+                if (a[bit / 8] & (@as(u8, 0x80) >> @intCast(bit % 8)) != 0) return error.BadCidr;
+            }
+            if (prev) |p| {
+                // strictly increasing by (prefix, addr)
+                if (prefix < prev_prefix) return error.BadCidr;
+                if (prefix == prev_prefix and std.mem.order(u8, p, a) != .lt) return error.BadCidr;
+            }
+            prev = a;
+            prev_prefix = prefix;
+        }
+    }
+
+    fn nameAt(s: *const Snapshot, i: u32) []const u8 {
+        const e = s.entries_off + @as(usize, i) * entry_len;
+        return s.bytes[s.strings_off + rd32(s.bytes, e + 8) ..][0..rd16(s.bytes, e + 12)];
+    }
+
+    /// The entry index holding exactly `name`, if any.
+    pub fn find(s: *const Snapshot, name: []const u8) ?u32 {
+        if (s.domains == 0) return null;
+        const h = fnv1a64(name);
+        const mask: u64 = s.buckets - 1;
+        var slot: u64 = h & mask;
+        var probes: u32 = 0;
+        while (probes < s.buckets) : (probes += 1) {
+            const v = rd32(s.bytes, s.buckets_off + @as(usize, @intCast(slot)) * 4);
+            if (v == 0) return null;
+            const i = v - 1;
+            if (i >= s.domains) return null;
+            const e = s.entries_off + @as(usize, i) * entry_len;
+            if (rd64(s.bytes, e) == h and std.mem.eql(u8, s.nameAt(i), name)) return i;
+            slot = (slot + 1) & mask;
+        }
+        return null;
+    }
+
+    pub const Acc = struct {
+        flags: u32 = 0,
+        cats: u64 = 0,
+        matched: bool = false,
+    };
+
+    /// Collects the bits of every rule that covers `name`: the exact entry's
+    /// self bits, and the sub bits of every proper suffix cut at a dot.
+    pub fn matchName(s: *const Snapshot, name: []const u8, acc: *Acc) void {
+        if (s.find(name)) |i| {
+            const e = s.entries_off + @as(usize, i) * entry_len;
+            acc.flags |= rd32(s.bytes, e + 16);
+            acc.cats |= rd64(s.bytes, e + 24);
+            acc.matched = true;
+        }
+        var pos: usize = 0;
+        while (std.mem.indexOfScalarPos(u8, name, pos, '.')) |dot| {
+            const suffix = name[dot + 1 ..];
+            pos = dot + 1;
+            if (suffix.len == 0) break;
+            if (s.find(suffix)) |i| {
+                const e = s.entries_off + @as(usize, i) * entry_len;
+                acc.flags |= rd32(s.bytes, e + 20);
+                acc.cats |= rd64(s.bytes, e + 32);
+                acc.matched = true;
+            }
+        }
+    }
+
+    /// Collects the bits of every CIDR rule containing `a` (all prefixes).
+    pub fn matchAddr(s: *const Snapshot, a: addr.Address, acc: *Acc) void {
+        const v6 = a.family == .v6;
+        const n = if (v6) s.v6 else s.v4;
+        const rl: usize = if (v6) v6_len else v4_len;
+        const al: usize = if (v6) 16 else 4;
+        const base = if (v6) s.v6_off else s.v4_off;
+        // entries are sorted by (prefix, addr): binary search each prefix group
+        var lo: u32 = 0;
+        while (lo < n) {
+            const prefix = s.bytes[base + @as(usize, lo) * rl + al];
+            var hi = lo;
+            while (hi < n and s.bytes[base + @as(usize, hi) * rl + al] == prefix) hi += 1;
+            var masked: [16]u8 = @splat(0);
+            maskInto(a.bytes[0..al], prefix, masked[0..al]);
+            var l = lo;
+            var r = hi;
+            while (l < r) {
+                const mid = l + (r - l) / 2;
+                const rec = base + @as(usize, mid) * rl;
+                switch (std.mem.order(u8, s.bytes[rec..][0..al], masked[0..al])) {
+                    .eq => {
+                        acc.flags |= rd32(s.bytes, rec + al + 4);
+                        acc.cats |= rd64(s.bytes, rec + (if (v6) al + 8 else al + 12));
+                        acc.matched = true;
+                        break;
+                    },
+                    .lt => l = mid + 1,
+                    .gt => r = mid,
+                }
+            }
+            lo = hi;
+        }
+    }
+
+    /// The owner's priority order over the collected bits (levels 1, 2, 4,
+    /// 5, 6; the strict network rules are checked by the caller in between).
+    pub fn judge(s: *const Snapshot, acc: Acc) Verdict {
+        const m = acc.cats & s.mandatory;
+        if (m != 0) return .{ .block = true, .level = .mandatory, .category = firstBit(m) };
+        if (acc.flags & rule_parent_block != 0) return .{ .block = true, .level = .parent_block };
+        const allowed = acc.flags & rule_parent_allow != 0;
+        const c = acc.cats & s.enabled & ~s.mandatory;
+        if (c != 0 and !allowed) return .{ .block = true, .level = .category, .category = firstBit(c) };
+        if (allowed) return .{ .level = .parent_allow };
+        const ac = acc.cats & s.allow_cats;
+        if (ac != 0) return .{ .level = .parent_allow, .category = firstBit(ac) };
+        if (s.flags & flag_unknown_block != 0) return .{ .block = true, .level = .unknown };
+        return .{};
+    }
+
+    /// DNS time: the verdict for a (normalized) query name.
+    pub fn checkName(s: *const Snapshot, name: []const u8) Verdict {
+        var acc: Acc = .{};
+        s.matchName(name, &acc);
+        return s.judge(acc);
+    }
+
+    /// Flow time. `name` is the fake-IP name (null for a real address or an
+    /// expired mapping); `fake` says the destination is in the fake range.
+    pub fn checkFlow(s: *const Snapshot, name: ?[]const u8, dst: addr.Address, fake: bool, proto: u8, dport: u16) Verdict {
+        var acc: Acc = .{};
+        if (name) |n| s.matchName(n, &acc);
+        if (!fake) s.matchAddr(dst, &acc);
+        // mandatory security and the parent's locked blocklist come first
+        const m = acc.cats & s.mandatory;
+        if (m != 0) return .{ .block = true, .level = .mandatory, .category = firstBit(m) };
+        if (acc.flags & rule_parent_block != 0) return .{ .block = true, .level = .parent_block };
+        // strict mode (optional): encrypted / alternative resolvers and QUIC
+        if (s.strictBlocks(name != null, fake, proto, dport)) return .{ .block = true, .level = .strict };
+        return s.judge(acc);
+    }
+
+    fn strictBlocks(s: *const Snapshot, named: bool, fake: bool, proto: u8, dport: u16) bool {
+        const f = s.flags;
+        if (f & flag_strict_dot != 0 and dport == 853) return true;
+        if (f & flag_strict_quic != 0 and proto == 17 and dport == 443) return true;
+        if (f & flag_strict_alt_dns != 0 and dport == 53 and !fake) return true;
+        if (f & flag_strict_direct_ip != 0 and !named and !fake) return true;
+        return false;
+    }
+};
+
+fn firstBit(v: u64) u8 {
+    return @as(u8, @intCast(@ctz(v))) + 1;
+}
+
+fn maskInto(src: []const u8, prefix: u8, out: []u8) void {
+    var i: usize = 0;
+    while (i < src.len) : (i += 1) {
+        const bits_before = i * 8;
+        if (prefix >= bits_before + 8) {
+            out[i] = src[i];
+        } else if (prefix <= bits_before) {
+            out[i] = 0;
+        } else {
+            const keep: u3 = @intCast(prefix - bits_before);
+            out[i] = src[i] & ~(@as(u8, 0xff) >> keep);
+        }
+    }
+}
+
+/// Normalizes a name the way the snapshot builder does: ASCII lowercase, one
+/// trailing dot dropped, every label carrying non-ASCII UTF-8 punycode
+/// encoded ("xn--"). Returns null for a name that can never be a rule
+/// (empty, too long, bad UTF-8, a character outside [a-z0-9-_]).
+/// Limit: no Unicode case folding / NFC (IDNA mapping) — the builder applies
+/// java.net.IDN, so exotic mappings (e.g. "ß") may differ; DNS queries are
+/// already punycode on the wire, so this path only matters for odd callers.
+pub fn normalize(in: []const u8, out: *[max_name]u8) ?[]const u8 {
+    var name = in;
+    if (name.len > 0 and name[name.len - 1] == '.') name = name[0 .. name.len - 1];
+    if (name.len == 0) return null;
+    var n: usize = 0;
+    var it = std.mem.splitScalar(u8, name, '.');
+    var first = true;
+    while (it.next()) |label| {
+        if (label.len == 0) return null;
+        if (!first) {
+            if (n >= max_name) return null;
+            out[n] = '.';
+            n += 1;
+        }
+        first = false;
+        var ascii = true;
+        for (label) |c| if (c >= 0x80) {
+            ascii = false;
+            break;
+        };
+        if (ascii) {
+            if (n + label.len > max_name) return null;
+            for (label) |c| {
+                out[n] = std.ascii.toLower(c);
+                n += 1;
+            }
+        } else {
+            const w = punycodeLabel(label, out[n..]) orelse return null;
+            n += w;
+        }
+    }
+    const res = out[0..n];
+    if (!validName(res)) return null;
+    return res;
+}
+
+/// RFC 3492 encoding of one label with the "xn--" prefix; ASCII letters are
+/// lowercased first. Returns the bytes written or null.
+fn punycodeLabel(label: []const u8, out: []u8) ?usize {
+    var cps: [64]u21 = undefined;
+    var count: usize = 0;
+    var view = std.unicode.Utf8View.init(label) catch return null;
+    var it = view.iterator();
+    while (it.nextCodepoint()) |cp0| {
+        if (count == cps.len) return null;
+        const cp: u21 = if (cp0 < 0x80) std.ascii.toLower(@intCast(cp0)) else cp0;
+        cps[count] = cp;
+        count += 1;
+    }
+    const base: u32 = 36;
+    const tmin: u32 = 1;
+    const tmax: u32 = 26;
+    var o: usize = 0;
+    const put = struct {
+        fn f(buf: []u8, pos: *usize, c: u8) bool {
+            if (pos.* >= buf.len) return false;
+            buf[pos.*] = c;
+            pos.* += 1;
+            return true;
+        }
+    }.f;
+    for ("xn--") |c| if (!put(out, &o, c)) return null;
+    var basic: usize = 0;
+    for (cps[0..count]) |cp| if (cp < 0x80) {
+        if (!put(out, &o, @intCast(cp))) return null;
+        basic += 1;
+    };
+    var h: usize = basic;
+    if (basic > 0) if (!put(out, &o, '-')) return null;
+    var n: u32 = 0x80;
+    var delta: u32 = 0;
+    var bias: u32 = 72;
+    while (h < count) {
+        var m: u32 = std.math.maxInt(u32);
+        for (cps[0..count]) |cp| if (cp >= n and cp < m) {
+            m = cp;
+        };
+        delta +|= (m - n) * @as(u32, @intCast(h + 1));
+        n = m;
+        for (cps[0..count]) |cp| {
+            if (cp < n) delta += 1;
+            if (cp == n) {
+                var q = delta;
+                var k: u32 = base;
+                while (true) : (k += base) {
+                    const t = if (k <= bias) tmin else if (k >= bias + tmax) tmax else k - bias;
+                    if (q < t) break;
+                    if (!put(out, &o, digit(t + (q - t) % (base - t)))) return null;
+                    q = (q - t) / (base - t);
+                }
+                if (!put(out, &o, digit(q))) return null;
+                bias = adapt(delta, @intCast(h + 1), h == basic);
+                delta = 0;
+                h += 1;
+            }
+        }
+        delta += 1;
+        n += 1;
+    }
+    return o;
+}
+
+fn digit(d: u32) u8 {
+    return if (d < 26) @intCast('a' + d) else @intCast('0' + d - 26);
+}
+
+fn adapt(delta0: u32, numpoints: u32, first: bool) u32 {
+    var delta = if (first) delta0 / 700 else delta0 / 2;
+    delta += delta / numpoints;
+    var k: u32 = 0;
+    while (delta > ((36 - 1) * 26) / 2) : (k += 36) delta /= 36 - 1;
+    return k + (36 * delta) / (delta + 38);
+}
+
+/// The live, swappable snapshot of one engine.
+pub const State = struct {
+    const Loaded = struct {
+        bytes: []u8,
+        snap: Snapshot,
+        next: ?*Loaded = null,
+    };
+
+    allocator: ?std.mem.Allocator = null,
+    current: std.atomic.Value(?*Loaded) = .init(null),
+    readers: std.atomic.Value(u32) = .init(0),
+    writer: std.atomic.Value(bool) = .init(false),
+    /// bumped by zeptun_revalidate_flows; workers re-check their flows
+    epoch: std.atomic.Value(u32) = .init(0),
+    retired: ?*Loaded = null,
+    // u32: 64-bit atomics are not available on every Android ABI
+    // (armeabi-v7a); the counters wrap after 2^32 events.
+    dns_blocked: std.atomic.Value(u32) = .init(0),
+    flow_blocked: std.atomic.Value(u32) = .init(0),
+    flows_killed: std.atomic.Value(u32) = .init(0),
+    swaps: std.atomic.Value(u32) = .init(0),
+    rejected: std.atomic.Value(u32) = .init(0),
+
+    pub const Counter = enum(u8) { dns_blocked = 0, flow_blocked = 1, flows_killed = 2, swaps = 3, rejected = 4, generation = 5, active = 6 };
+
+    pub fn counter(s: *State, c: Counter) u64 {
+        return switch (c) {
+            .dns_blocked => s.dns_blocked.load(.monotonic),
+            .flow_blocked => s.flow_blocked.load(.monotonic),
+            .flows_killed => s.flows_killed.load(.monotonic),
+            .swaps => s.swaps.load(.monotonic),
+            .rejected => s.rejected.load(.monotonic),
+            .generation => blk: {
+                const g = s.acquire();
+                defer s.release();
+                break :blk if (g) |snap| snap.generation else 0;
+            },
+            .active => @intFromBool(s.current.load(.seq_cst) != null),
+        };
+    }
+
+    pub inline fn active(s: *const State) bool {
+        return s.current.load(.monotonic) != null;
+    }
+
+    /// Reader side: pin the current snapshot for one short lookup. Every
+    /// acquire must be followed by release on the same thread.
+    pub fn acquire(s: *State) ?*const Snapshot {
+        _ = s.readers.fetchAdd(1, .seq_cst);
+        const p = s.current.load(.seq_cst) orelse return null;
+        return &p.snap;
+    }
+
+    pub fn release(s: *State) void {
+        _ = s.readers.fetchSub(1, .seq_cst);
+    }
+
+    fn lockWriter(s: *State) void {
+        while (s.writer.cmpxchgWeak(false, true, .acquire, .monotonic) != null) std.Thread.yield() catch {};
+    }
+
+    fn unlockWriter(s: *State) void {
+        s.writer.store(false, .release);
+    }
+
+    /// Validates `bytes` completely, copies them and swaps them in
+    /// atomically. An invalid snapshot is refused and the previous one stays
+    /// active. Null/empty clears the shield.
+    pub fn install(s: *State, bytes: ?[]const u8) Error!void {
+        const alloc = s.allocator orelse return error.OutOfMemory;
+        var fresh: ?*Loaded = null;
+        if (bytes) |b| if (b.len > 0) {
+            _ = Snapshot.parse(b) catch |err| {
+                _ = s.rejected.fetchAdd(1, .monotonic);
+                return err;
+            };
+            const copy = alloc.alloc(u8, b.len) catch return error.OutOfMemory;
+            errdefer alloc.free(copy);
+            @memcpy(copy, b);
+            const l = alloc.create(Loaded) catch return error.OutOfMemory;
+            // parse again on the private copy (the views must point into it)
+            l.* = .{ .bytes = copy, .snap = Snapshot.parse(copy) catch unreachable };
+            fresh = l;
+        };
+        s.lockWriter();
+        defer s.unlockWriter();
+        const old = s.current.swap(fresh, .seq_cst);
+        _ = s.swaps.fetchAdd(1, .monotonic);
+        if (old) |o| s.retire(o);
+    }
+
+    /// Frees `o` once no reader can still hold it. Readers pin only for one
+    /// lookup, so the wait is short; if it ever is not, the snapshot is kept
+    /// on the retired list and freed with the engine.
+    fn retire(s: *State, o: *Loaded) void {
+        var spins: u32 = 0;
+        while (s.readers.load(.seq_cst) != 0) : (spins += 1) {
+            if (spins > 200_000) {
+                o.next = s.retired;
+                s.retired = o;
+                return;
+            }
+            std.Thread.yield() catch {};
+        }
+        s.free(o);
+    }
+
+    fn free(s: *State, o: *Loaded) void {
+        const alloc = s.allocator.?;
+        alloc.free(o.bytes);
+        alloc.destroy(o);
+    }
+
+    pub fn bumpEpoch(s: *State) void {
+        _ = s.epoch.fetchAdd(1, .release);
+    }
+
+    pub fn deinit(s: *State) void {
+        if (s.allocator == null) return;
+        if (s.current.swap(null, .seq_cst)) |o| s.free(o);
+        var r = s.retired;
+        while (r) |o| {
+            r = o.next;
+            s.free(o);
+        }
+        s.retired = null;
+    }
+};
