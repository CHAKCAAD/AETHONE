+test "shield: atomic install keeps the previous snapshot on a bad one" {
+    const alloc = std.testing.allocator;
+    var st: State = .{ .allocator = alloc };
+    defer st.deinit();
+    try std.testing.expect(!st.active());
+    const b = try sampleSnapshot(alloc, 0);
+    defer alloc.free(b);
+    try st.install(b);
+    try std.testing.expect(st.active());
+    {
+        const s = st.acquire().?;
+        defer st.release();
+        try std.testing.expect(s.checkName("example.com").block);
+    }
+    // corrupt copy is refused, the old one stays
+    const c = try alloc.dupe(u8, b);
+    defer alloc.free(c);
+    c[200] ^= 0xff;
+    try std.testing.expectError(error.BadChecksum, st.install(c));
+    try std.testing.expectEqual(@as(u64, 1), st.counter(.rejected));
+    {
+        const s = st.acquire().?;
+        defer st.release();
+        try std.testing.expect(s.checkName("www.example.com").block);
+    }
+    // replace with an allowlist-only snapshot
+    const b2 = try sampleSnapshot(alloc, flag_unknown_block);
+    defer alloc.free(b2);
+    try st.install(b2);
+    {
+        const s = st.acquire().?;
+        defer st.release();
+        try std.testing.expect(s.checkName("unknown.org").block);
+    }
+    // the installed copy is private: mutating the caller's buffer changes nothing
+    b2[0] = 'Z';
+    {
+        const s = st.acquire().?;
+        defer st.release();
+        try std.testing.expect(s.checkName("unknown.org").block);
+    }
+    // clear
+    try st.install(null);
+    try std.testing.expect(!st.active());
+    try std.testing.expect(st.acquire() == null);
+    st.release();
+    try std.testing.expectEqual(@as(u64, 3), st.counter(.swaps));
+}
