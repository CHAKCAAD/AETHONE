+/// Test-only builder producing the v1 format (the shipped builder is Kotlin).
+pub const TestBuilder = struct {
+    pub const Rule = struct { name: []const u8, self_flags: u32 = 0, sub_flags: u32 = 0, self_cats: u64 = 0, sub_cats: u64 = 0 };
+    pub const Cidr = struct { a: []const u8, prefix: u8, flags: u32 = 0, cats: u64 = 0 };
+
+    pub fn build(alloc: std.mem.Allocator, flags: u32, enabled: u64, mandatory: u64, allow_cats: u64, rules: []const Rule, v4: []const Cidr, v6: []const Cidr) ![]u8 {
+        var buckets: u32 = 1;
+        while (buckets < rules.len * 2 + 1) buckets *= 2;
+        var strings_len: usize = 0;
+        for (rules) |r| strings_len += r.name.len;
+        const total = header_len + rules.len * entry_len + buckets * 4 + v4.len * v4_len + v6.len * v6_len + strings_len;
+        const b = try alloc.alloc(u8, total);
+        @memset(b, 0);
+        @memcpy(b[0..8], magic);
+        std.mem.writeInt(u16, b[8..10], version, .little);
+        std.mem.writeInt(u16, b[10..12], header_len, .little);
+        std.mem.writeInt(u32, b[12..16], flags, .little);
+        std.mem.writeInt(u32, b[16..20], @intCast(total), .little);
+        std.mem.writeInt(u32, b[20..24], 7, .little);
+        std.mem.writeInt(u64, b[24..32], enabled, .little);
+        std.mem.writeInt(u64, b[32..40], mandatory, .little);
+        std.mem.writeInt(u64, b[40..48], allow_cats, .little);
+        std.mem.writeInt(u32, b[48..52], @intCast(rules.len), .little);
+        std.mem.writeInt(u32, b[52..56], buckets, .little);
+        std.mem.writeInt(u32, b[56..60], @intCast(v4.len), .little);
+        std.mem.writeInt(u32, b[60..64], @intCast(v6.len), .little);
+        std.mem.writeInt(u32, b[64..68], @intCast(strings_len), .little);
+        const eo = header_len;
+        const bo = eo + rules.len * entry_len;
+        const v4o = bo + buckets * 4;
+        const v6o = v4o + v4.len * v4_len;
+        const so = v6o + v6.len * v6_len;
+        var soff: usize = 0;
+        for (rules, 0..) |r, i| {
+            const e = eo + i * entry_len;
+            const h = fnv1a64(r.name);
+            std.mem.writeInt(u64, b[e..][0..8], h, .little);
+            std.mem.writeInt(u32, b[e + 8 ..][0..4], @intCast(soff), .little);
+            std.mem.writeInt(u16, b[e + 12 ..][0..2], @intCast(r.name.len), .little);
+            std.mem.writeInt(u32, b[e + 16 ..][0..4], r.self_flags, .little);
+            std.mem.writeInt(u32, b[e + 20 ..][0..4], r.sub_flags, .little);
+            std.mem.writeInt(u64, b[e + 24 ..][0..8], r.self_cats, .little);
+            std.mem.writeInt(u64, b[e + 32 ..][0..8], r.sub_cats, .little);
+            @memcpy(b[so + soff ..][0..r.name.len], r.name);
+            soff += r.name.len;
+            var slot: usize = @intCast(h & (buckets - 1));
+            while (std.mem.readInt(u32, b[bo + slot * 4 ..][0..4], .little) != 0) slot = (slot + 1) & (buckets - 1);
+            std.mem.writeInt(u32, b[bo + slot * 4 ..][0..4], @intCast(i + 1), .little);
+        }
+        for (v4, 0..) |c, i| {
+            const r = v4o + i * v4_len;
+            @memcpy(b[r..][0..4], c.a[0..4]);
+            b[r + 4] = c.prefix;
+            std.mem.writeInt(u32, b[r + 8 ..][0..4], c.flags, .little);
+            std.mem.writeInt(u64, b[r + 16 ..][0..8], c.cats, .little);
+        }
+        for (v6, 0..) |c, i| {
+            const r = v6o + i * v6_len;
+            @memcpy(b[r..][0..16], c.a[0..16]);
+            b[r + 16] = c.prefix;
+            std.mem.writeInt(u32, b[r + 20 ..][0..4], c.flags, .little);
+            std.mem.writeInt(u64, b[r + 24 ..][0..8], c.cats, .little);
+        }
+        seal(b);
+        return b;
+    }
+
+    pub fn seal(b: []u8) void {
+        @memset(b[96..128], 0);
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(b, &digest, .{});
+        @memcpy(b[96..128], &digest);
+    }
+};
+
+const cat_adult: u64 = 1 << 2;
+const cat_malware: u64 = 1 << 0;
+const cat_phishing: u64 = 1 << 1;
+const cat_social: u64 = 1 << 5;
+
+fn sampleSnapshot(alloc: std.mem.Allocator, flags: u32) ![]u8 {
+    const rules = [_]TestBuilder.Rule{
+        // root rule: the name and every subdomain
+        .{ .name = "example.com", .self_cats = cat_adult, .sub_cats = cat_adult },
+        // exact rule only
+        .{ .name = "exact.test", .self_flags = rule_parent_block },
+        // wildcard: subdomains only
+        .{ .name = "wild.test", .sub_flags = rule_parent_block },
+        .{ .name = "evil.test", .self_cats = cat_malware, .sub_cats = cat_malware },
+        .{ .name = "safe.example.com", .self_flags = rule_parent_allow, .sub_flags = rule_parent_allow },
+        .{ .name = "phish.example.com", .self_flags = rule_parent_allow, .self_cats = cat_phishing },
+        .{ .name = "xn--mnchen-3ya.de", .self_flags = rule_parent_block, .sub_flags = rule_parent_block },
+        .{ .name = "kids.test", .self_flags = rule_parent_allow, .sub_flags = rule_parent_allow },
+    };
+    const v4 = [_]TestBuilder.Cidr{
+        .{ .a = &[_]u8{ 1, 1, 1, 1 }, .prefix = 32, .cats = cat_social },
+        .{ .a = &[_]u8{ 10, 0, 0, 0 }, .prefix = 8, .flags = rule_parent_block },
+        .{ .a = &[_]u8{ 203, 0, 113, 0 }, .prefix = 24, .flags = rule_parent_allow },
+    };
+    // sorted by (prefix, addr)
+    var sorted4 = v4;
+    std.mem.sort(TestBuilder.Cidr, &sorted4, {}, struct {
+        fn lt(_: void, a: TestBuilder.Cidr, b: TestBuilder.Cidr) bool {
+            if (a.prefix != b.prefix) return a.prefix < b.prefix;
+            return std.mem.order(u8, a.a, b.a) == .lt;
+        }
+    }.lt);
+    var six: [16]u8 = @splat(0);
+    six[0] = 0x20;
+    six[1] = 0x01;
+    six[2] = 0x0d;
+    six[3] = 0xb8;
+    const v6 = [_]TestBuilder.Cidr{.{ .a = &six, .prefix = 32, .flags = rule_parent_block }};
+    return TestBuilder.build(alloc, flags, cat_adult | cat_social | cat_malware | cat_phishing, cat_malware | cat_phishing, 0, &rules, &sorted4, &v6);
+}
