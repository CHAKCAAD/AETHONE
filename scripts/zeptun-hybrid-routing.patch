+
+test "route callback sees the fake-ip name" {
+    const Seen = struct {
+        var name_len: usize = 0;
+        var first: u8 = 0;
+        fn answer(ctx: ?*anyopaque, flow: *const Flow, name: ?[*]const u8, len: usize) callconv(.c) u32 {
+            _ = ctx;
+            _ = flow;
+            name_len = len;
+            first = if (name) |n| n[0] else 0;
+            return 17;
+        }
+    };
+    const j: Judge = .{ .route_call = Seen.answer };
+    const r = j.askRoute(2, 6, false, &[_]u8{ 10, 0, 0, 2 }, 1, &[_]u8{ 198, 18, 0, 5 }, 443, "example.com");
+    try std.testing.expectEqual(@as(u8, 2), r.route);
+    try std.testing.expectEqual(@as(usize, 11), Seen.name_len);
