+/// AETHONE traffic analytics: one metered byte report for a proxied flow.
+/// `up` is payload the app sent that zeptun wrote to the flow's SOCKS5
+/// stream; `down` is payload zeptun read from that stream for the app (the
+/// upstream_tx/rx_bytes measuring point, per flow). Both are DELTAS since the
+/// previous report of the same flow; `closed` = 1 on the flow's last report.
+/// `route` is the route the flow was really dialled on (0 = default server,
+/// n = routes[n-1]).
+pub const MeterRecord = extern struct {
+    flow: Flow,
+    route: u8,
+    closed: u8,
+    up: u64,
+    down: u64,
+};
+
+pub const MeterFn = *const fn (ctx: ?*anyopaque, rec: *const MeterRecord) callconv(.c) void;
+
+/// A live flow reports at least this often while it moves bytes ...
+pub const meter_interval_ms: u64 = 2_000;
+/// ... or as soon as this many unreported bytes pile up.
+pub const meter_flush_bytes: u64 = 256 * 1024;
+
+pub const Routed = struct {
+    action: Action,
+    route: u8 = 0,
+};
+
+fn makeFlow(proto: u8, v6: bool, src: []const u8, src_port: u16, dst: []const u8, dst_port: u16) Flow {
+    var flow: Flow = .{
+        .protocol = proto,
+        .family = if (v6) 6 else 4,
+        .source = @splat(0),
+        .destination = @splat(0),
+        .source_port = src_port,
+        .destination_port = dst_port,
+    };
+    const sl = @min(src.len, flow.source.len);
+    const dl = @min(dst.len, flow.destination.len);
+    @memcpy(flow.source[0..sl], src[0..sl]);
+    @memcpy(flow.destination[0..dl], dst[0..dl]);
+    return flow;
+}
+
+pub fn decodeRoute(v: u32, route_count: u8) Routed {
+    return switch (v) {
+        0 => .{ .action = .proxy },
+        2 => .{ .action = .drop },
+        3 => .{ .action = .reject },
+        else => if (v >= route_base and v - route_base < route_count)
+            .{ .action = .proxy, .route = @intCast(v - route_base + 1) }
+        else
+            .{ .action = .reject },
+    };
+}
