+        const flow = makeFlow(proto, v6, src, src_port, dst, dst_port);
+        const v = if (name) |n| f(j.route_ctx, &flow, n.ptr, n.len) else f(j.route_ctx, &flow, null, 0);
+        return decodeRoute(v, route_count);
+    }
