     try std.testing.expectEqual(@as(u8, 6), Seen.last.family);
 }
+
+test "route answers map to servers and never to direct" {
+    try std.testing.expectEqual(Action.proxy, decodeRoute(0, 2).action);
+    try std.testing.expectEqual(@as(u8, 0), decodeRoute(0, 2).route);
+    try std.testing.expectEqual(@as(u8, 1), decodeRoute(16, 2).route);
+    try std.testing.expectEqual(@as(u8, 2), decodeRoute(17, 2).route);
+    try std.testing.expectEqual(Action.reject, decodeRoute(18, 2).action);
+    try std.testing.expectEqual(Action.reject, decodeRoute(1, 2).action);
+    try std.testing.expectEqual(Action.drop, decodeRoute(2, 2).action);
+    try std.testing.expectEqual(Action.reject, decodeRoute(16, 0).action);
