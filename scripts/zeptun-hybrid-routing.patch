+test "shield: invalid snapshots are rejected" {
+    const alloc = std.testing.allocator;
+    const b = try sampleSnapshot(alloc, 0);
+    defer alloc.free(b);
+    _ = try Snapshot.parse(b);
+    try std.testing.expectError(error.TooShort, Snapshot.parse(b[0..64]));
+    try std.testing.expectError(error.BadLength, Snapshot.parse(b[0 .. b.len - 1]));
+    const c = try alloc.dupe(u8, b);
+    defer alloc.free(c);
+    // one flipped payload bit breaks the checksum
+    c[c.len - 1] ^= 1;
+    try std.testing.expectError(error.BadChecksum, Snapshot.parse(c));
+    c[c.len - 1] ^= 1;
+    _ = try Snapshot.parse(c);
+    // bad magic / version
+    c[0] = 'X';
+    try std.testing.expectError(error.BadMagic, Snapshot.parse(c));
+    c[0] = 'A';
+    c[8] = 9;
+    try std.testing.expectError(error.BadVersion, Snapshot.parse(c));
+    c[8] = 1;
+    // a resealed snapshot with a broken entry hash is still refused
+    std.mem.writeInt(u64, c[header_len..][0..8], 1234, .little);
+    TestBuilder.seal(c);
+    try std.testing.expectError(error.BadEntry, Snapshot.parse(c));
+    // CIDR with host bits set
+    const bad = [_]TestBuilder.Cidr{.{ .a = &[_]u8{ 10, 0, 0, 1 }, .prefix = 8 }};
+    const cb = try TestBuilder.build(alloc, 0, 0, 0, 0, &.{}, &bad, &.{});
+    defer alloc.free(cb);
+    try std.testing.expectError(error.BadCidr, Snapshot.parse(cb));
+    // uppercase / invalid names are refused (the builder normalizes)
+    const up = [_]TestBuilder.Rule{.{ .name = "Example.com", .self_flags = rule_parent_block }};
+    const ub = try TestBuilder.build(alloc, 0, 0, 0, 0, &up, &.{}, &.{});
+    defer alloc.free(ub);
+    try std.testing.expectError(error.BadEntry, Snapshot.parse(ub));
+    // unknown header flags
+    const fb = try TestBuilder.build(alloc, 1 << 20, 0, 0, 0, &.{}, &.{}, &.{});
+    defer alloc.free(fb);
+    try std.testing.expectError(error.BadHeader, Snapshot.parse(fb));
+}
