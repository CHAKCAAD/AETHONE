+++ b/src/tests/shield_engine_tests.zig
@@ -0,0 +1,267 @@
+//! AETHONE Family Shield — end-to-end engine tests (external device, real
+//! sockets on loopback): DNS NXDOMAIN through the engine, TCP RST and UDP
+//! ICMP reject before any dial, flow-time re-check of a cached fake IP, and
+//! revalidation of live flows after a rule change.
+const std = @import("std");
+const addr = @import("../addr.zig");
+const config = @import("../config.zig");
+const engine = @import("../engine.zig");
+const sys = @import("../io/sys.zig");
+const parse = @import("../packet/parse.zig");
+const stats = @import("../stats.zig");
+const external = @import("../device/external.zig");
+const shield = @import("../flow/shield.zig");
+const h = @import("helpers.zig");
+
+fn directConfig() config.Config {
+    var cfg = config.Config.fromPreset(.mobile);
+    cfg.device.kind = .external;
+    cfg.stack.mode = .userspace;
+    cfg.handler.kind = .direct;
+    cfg.io.workers = 1;
+    cfg.log_level = .warn;
+    cfg.stack.tcp_timestamps = false;
+    return cfg;
+}
+
+fn blockV4(alloc: std.mem.Allocator, a: [4]u8, prefix: u8) ![]u8 {
+    const v4 = [_]shield.TestBuilder.Cidr{.{ .a = &a, .prefix = prefix, .flags = shield.rule_parent_block }};
+    return shield.TestBuilder.build(alloc, 0, 0, 0, 0, &.{}, &v4, &.{});
+}
+
+fn inject(e: *engine.Engine, pkt: []const u8) !void {
+    const pk: external.Packet = .{ .data = pkt.ptr, .len = pkt.len };
+    if (e.external.?.injectBatch(&.{pk}) != 1) return error.InjectFailed;
+}
+
+/// Next packet for `port` (the client side), skipping others.
+fn nextFor(c: *h.Collector, port: u16, timeout_ms: u64, out: []u8) ?parse.Packet {
+    const deadline = sys.monotonicMs() + timeout_ms;
+    while (sys.monotonicMs() < deadline) {
+        const raw = c.next(20, out) orelse continue;
+        const p = parse.parse(raw) catch continue;
+        switch (p.l4) {
+            .tcp => |t| if (t.dst_port == port) return p,
+            .udp => |u| if (u.dst_port == port) return p,
+            .icmp => return p,
+            else => {},
+        }
+    }
+    return null;
+}
+
+const syn_opts = [_]u8{ 2, 4, 0x05, 0xb4, 4, 2, 1, 3, 3, 7 };
+
+test "shield engine: blocked TCP SYN gets RST and is never dialled" {
+    if (!sys.is_linux) return error.SkipZigTest;
+    const alloc = std.testing.allocator;
+    var echo: h.TcpEcho = .{ .fd = -1, .port = 0 };
+    try echo.start();
+    defer echo.deinit();
+    var collector: h.Collector = .{};
+    const e = try engine.Engine.create(alloc, directConfig());
+    defer e.destroy();
+    e.external.?.setOutput(h.Collector.output, &collector);
+    const snap = try blockV4(alloc, .{ 127, 0, 0, 1 }, 32);
+    defer alloc.free(snap);
+    try e.installShield(snap);
+    try e.start();
+    var buf: [256]u8 = undefined;
+    const client = try addr.Endpoint.parse("10.0.0.2:40001");
+    const server: addr.Endpoint = .{ .addr = try addr.Address.parse("127.0.0.1"), .port = echo.port };
+    try inject(e, h.buildTcp4(&buf, client, server, .{ .seq = 999, .ack = 0, .flags = 0x02, .options = &syn_opts }));
+    var out: [2048]u8 = undefined;
+    const p = nextFor(&collector, 40001, 3000, &out) orelse return error.NoReply;
+    try std.testing.expect(p.l4 == .tcp);
+    try std.testing.expect(p.l4.tcp.flags.rst);
+    var s: stats.Snapshot = .{};
+    e.snapshot(&s);
+    try std.testing.expectEqual(@as(u64, 0), s.tcp_opened);
+    try std.testing.expectEqual(@as(u64, 1), e.shield.counter(.flow_blocked));
+    try std.testing.expectEqual(@as(u64, 0), echo.bytes.load(.acquire));
+    e.stop();
+}
+
+test "shield engine: blocked UDP gets ICMP port unreachable" {
+    if (!sys.is_linux) return error.SkipZigTest;
+    const alloc = std.testing.allocator;
+    var echo: h.UdpEcho = .{ .fd = -1, .port = 0 };
+    try echo.start();
+    defer echo.deinit();
+    var collector: h.Collector = .{};
+    const e = try engine.Engine.create(alloc, directConfig());
+    defer e.destroy();
+    e.external.?.setOutput(h.Collector.output, &collector);
+    const snap = try blockV4(alloc, .{ 127, 0, 0, 0 }, 8);
+    defer alloc.free(snap);
+    try e.installShield(snap);
+    try e.start();
+    var buf: [256]u8 = undefined;
+    const client = try addr.Endpoint.parse("10.0.0.2:5556");
+    const server: addr.Endpoint = .{ .addr = try addr.Address.parse("127.0.0.1"), .port = echo.port };
+    try inject(e, h.buildUdp4(&buf, client, server, "blocked"));
+    var out: [2048]u8 = undefined;
+    const p = nextFor(&collector, 5556, 3000, &out) orelse return error.NoReply;
+    try std.testing.expect(p.l4 == .icmp);
+    var s: stats.Snapshot = .{};
+    e.snapshot(&s);
+    try std.testing.expectEqual(@as(u64, 0), s.udp_opened);
+    try std.testing.expectEqual(@as(u64, 1), e.shield.counter(.flow_blocked));
+    e.stop();
+}
+
+/// Opens a TCP flow through the engine to `server` and completes the
+/// handshake; returns the client's next sequence / ack numbers.
+const Flow = struct {
+    client: addr.Endpoint,
+    server: addr.Endpoint,
+    snd: u32 = 1000,
+    rcv: u32 = 0,
+
+    fn open(f: *Flow, e: *engine.Engine, c: *h.Collector) !void {
+        var buf: [256]u8 = undefined;
+        try inject(e, h.buildTcp4(&buf, f.client, f.server, .{ .seq = 999, .ack = 0, .flags = 0x02, .options = &syn_opts }));
+        var out: [2048]u8 = undefined;
+        const p = nextFor(c, f.client.port, 3000, &out) orelse return error.NoSynAck;
+        if (p.l4 != .tcp or !(p.l4.tcp.flags.syn and p.l4.tcp.flags.ack)) return error.NoSynAck;
+        f.rcv = p.l4.tcp.seq +% 1;
+        try inject(e, h.buildTcp4(&buf, f.client, f.server, .{ .seq = f.snd, .ack = f.rcv, .flags = 0x10 }));
+    }
+
+    fn send(f: *Flow, e: *engine.Engine, data: []const u8) !void {
+        var buf: [512]u8 = undefined;
+        try inject(e, h.buildTcp4(&buf, f.client, f.server, .{ .seq = f.snd, .ack = f.rcv, .flags = 0x18, .payload = data }));
+        f.snd +%= @intCast(data.len);
+    }
+};
+
+test "shield engine: revalidation aborts a newly blocked flow and leaves an allowed one untouched" {
+    if (!sys.is_linux) return error.SkipZigTest;
+    const alloc = std.testing.allocator;
+    var echo1: h.TcpEcho = .{ .fd = -1, .port = 0 };
+    try echo1.start();
+    defer echo1.deinit();
+    var echo2: h.TcpEcho = .{ .fd = -1, .port = 0, .host = "127.0.0.2:0" };
+    echo2.start() catch return error.SkipZigTest; // 127.0.0.2 not bindable here
+    defer echo2.deinit();
+    var collector: h.Collector = .{};
+    const e = try engine.Engine.create(alloc, directConfig());
+    defer e.destroy();
+    e.external.?.setOutput(h.Collector.output, &collector);
+    // an active snapshot that blocks nothing relevant
+    const none = try blockV4(alloc, .{ 192, 0, 2, 0 }, 24);
+    defer alloc.free(none);
+    try e.installShield(none);
+    try e.start();
+    var a: Flow = .{ .client = try addr.Endpoint.parse("10.0.0.2:40010"), .server = .{ .addr = try addr.Address.parse("127.0.0.1"), .port = echo1.port } };
+    var b: Flow = .{ .client = try addr.Endpoint.parse("10.0.0.2:40011"), .server = .{ .addr = try addr.Address.parse("127.0.0.2"), .port = echo2.port } };
+    try a.open(e, &collector);
+    try b.open(e, &collector);
+    // rule change: 127.0.0.1 becomes blocked; then revalidate
+    const block = try blockV4(alloc, .{ 127, 0, 0, 1 }, 32);
+    defer alloc.free(block);
+    try e.installShield(block);
+    e.revalidateFlows();
+    var out: [2048]u8 = undefined;
+    var got_rst = false;
+    const deadline = sys.monotonicMs() + 3000;
+    while (!got_rst and sys.monotonicMs() < deadline) {
+        const p = nextFor(&collector, 40010, 100, &out) orelse continue;
+        if (p.l4 == .tcp and p.l4.tcp.flags.rst) got_rst = true;
+    }
+    try std.testing.expect(got_rst);
+    try std.testing.expectEqual(@as(u64, 1), e.shield.counter(.flows_killed));
+    // flow b still carries data both ways
+    try b.send(e, "still allowed");
+    var echoed = false;
+    const d2 = sys.monotonicMs() + 3000;
+    while (!echoed and sys.monotonicMs() < d2) {
+        const p = nextFor(&collector, 40011, 100, &out) orelse continue;
+        if (p.l4 == .tcp and p.l4.tcp.flags.rst) return error.AllowedFlowReset;
+        if (p.payload_len > 0) echoed = true;
+    }
+    try std.testing.expect(echoed);
+    e.stop();
+}
+
+fn dnsQuery(buf: []u8, id: u16, name: []const u8, qtype: u16) []u8 {
+    std.mem.writeInt(u16, buf[0..2], id, .big);
+    std.mem.writeInt(u16, buf[2..4], 0x0100, .big);
+    std.mem.writeInt(u16, buf[4..6], 1, .big);
+    @memset(buf[6..12], 0);
+    var off: usize = 12;
+    var it = std.mem.splitScalar(u8, name, '.');
+    while (it.next()) |label| {
+        buf[off] = @intCast(label.len);
+        @memcpy(buf[off + 1 ..][0..label.len], label);
+        off += 1 + label.len;
+    }
+    buf[off] = 0;
+    std.mem.writeInt(u16, buf[off + 1 ..][0..2], qtype, .big);
+    std.mem.writeInt(u16, buf[off + 3 ..][0..2], 1, .big);
+    return buf[0 .. off + 5];
+}
+
+test "shield engine: fake-ip DNS answers NXDOMAIN for blocked names and re-checks cached fake IPs at flow open" {
+    if (!sys.is_linux) return error.SkipZigTest;
+    const alloc = std.testing.allocator;
+    var collector: h.Collector = .{};
+    var cfg = config.Config.fromPreset(.mobile);
+    cfg.device.kind = .external;
+    cfg.stack.mode = .userspace;
+    cfg.handler.kind = .socks5;
+    cfg.handler.socks5.server = try addr.Endpoint.parse("127.0.0.1:9");
+    cfg.dns.fake_ip = true;
+    cfg.io.workers = 1;
+    cfg.log_level = .warn;
+    const e = try engine.Engine.create(alloc, cfg);
+    defer e.destroy();
+    e.external.?.setOutput(h.Collector.output, &collector);
+    const rules = [_]shield.TestBuilder.Rule{.{ .name = "blocked.test", .self_flags = shield.rule_parent_block, .sub_flags = shield.rule_parent_block }};
+    const snap = try shield.TestBuilder.build(alloc, 0, 0, 0, 0, &rules, &.{}, &.{});
+    defer alloc.free(snap);
+    try e.installShield(snap);
+    try e.start();
+    const resolver = try addr.Endpoint.parse("172.19.0.2:53");
+    var q: [256]u8 = undefined;
+    var pb: [512]u8 = undefined;
+    var out: [2048]u8 = undefined;
+    var port: u16 = 30000;
+    // blocked: A, AAAA, HTTPS (65), SVCB (64) → NXDOMAIN, no answers, no authority
+    for ([_]u16{ 1, 28, 65, 64 }) |qt| {
+        port += 1;
+        const client: addr.Endpoint = .{ .addr = try addr.Address.parse("10.0.0.2"), .port = port };
+        try inject(e, h.buildUdp4(&pb, client, resolver, dnsQuery(&q, port, "www.blocked.test", qt)));
+        const p = nextFor(&collector, port, 3000, &out) orelse return error.NoDnsReply;
+        const dns = out[p.payload_off..][0..p.payload_len];
+        try std.testing.expectEqual(@as(u16, 3), std.mem.readInt(u16, dns[2..4], .big) & 0xf);
+        try std.testing.expectEqual(@as(u16, 0), std.mem.readInt(u16, dns[6..8], .big));
+        try std.testing.expectEqual(@as(u16, 0), std.mem.readInt(u16, dns[8..10], .big));
+    }
+    try std.testing.expectEqual(@as(u64, 4), e.shield.counter(.dns_blocked));
+    // allowed: a fake IP comes back
+    port += 1;
+    const c2: addr.Endpoint = .{ .addr = try addr.Address.parse("10.0.0.2"), .port = port };
+    try inject(e, h.buildUdp4(&pb, c2, resolver, dnsQuery(&q, port, "cached.test", 1)));
+    const p2 = nextFor(&collector, port, 3000, &out) orelse return error.NoDnsReply;
+    const dns2 = out[p2.payload_off..][0..p2.payload_len];
+    try std.testing.expectEqual(@as(u16, 0), std.mem.readInt(u16, dns2[2..4], .big) & 0xf);
+    try std.testing.expectEqual(@as(u16, 1), std.mem.readInt(u16, dns2[6..8], .big));
+    const fake = addr.Address.v4(dns2[dns2.len - 4 ..][0..4].*);
+    try std.testing.expect(e.fake_dns.?.contains(fake));
+    // the parent blocks cached.test later; the app still holds the fake IP
+    const rules2 = [_]shield.TestBuilder.Rule{.{ .name = "cached.test", .self_flags = shield.rule_parent_block, .sub_flags = shield.rule_parent_block }};
+    const snap2 = try shield.TestBuilder.build(alloc, 0, 0, 0, 0, &rules2, &.{}, &.{});
+    defer alloc.free(snap2);
+    try e.installShield(snap2);
+    var tb: [256]u8 = undefined;
+    const tc = try addr.Endpoint.parse("10.0.0.2:41000");
+    try inject(e, h.buildTcp4(&tb, tc, .{ .addr = fake, .port = 443 }, .{ .seq = 999, .ack = 0, .flags = 0x02, .options = &syn_opts }));
+    const p3 = nextFor(&collector, 41000, 3000, &out) orelse return error.NoReply;
+    try std.testing.expect(p3.l4 == .tcp and p3.l4.tcp.flags.rst);
+    try std.testing.expectEqual(@as(u64, 1), e.shield.counter(.flow_blocked));
+    var s: stats.Snapshot = .{};
+    e.snapshot(&s);
+    try std.testing.expectEqual(@as(u64, 0), s.tcp_opened);
+    e.stop();
+}
